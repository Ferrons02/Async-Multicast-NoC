template<pint BW>
defproc InputRouter(
    chan(int<BW>)? I;
    chan(int<BW>)! O0,O1
){

    int<32>buf;
    bool pyld;

    chp{
        
        pyld:=false;
        *[I?buf;[
            ~pyld-> O0!buf, pyld:=buf{7..4} = 0
            [] pyld-> O1!buf, pyld:=buf{0}=0
        ]]

    }

}

template<pint BW>
defproc Serializer(
    chan(int<BW>)? I;
    chan(int<4>)! O
){

    int<32>buf;

    chp{

        *[I?buf;O!buf{31..28};O!buf{27..24};O!buf{23..20};O!buf{19..16};O!buf{15..12};O!buf{11..8};O!buf{7..4}]

    }
}

defproc QuadRouter(
    chan(int<4>)? I;
    chan(int)? Cnt0,Cnt1,Cnt2,Cnt3;
    chan(int<4>)! O_cnt0,O_cnt1,O_cnt2,O_cnt3,O_ds0,O_ds1,O_ds2,O_ds3,Ch;
    chan(int<1>)!F0,F1,F2,F3
) {

    int<4> buf;
    int cnt0,cnt1,cnt2,cnt3;
    bool init;

    chp{

        init:=true;
        *[[init-> F0!,F1!,F2!,F3!; I?buf; [buf!=0-> init:=false, cnt0:=buf{3}, cnt1:=buf{2}, cnt2:=buf{1}, cnt3:=buf{0}, Ch!buf; I?buf [] buf=0->skip]
            [] ~init->
            *[cnt0!=0-> O_cnt0!buf, O_ds0!buf, cnt0:=cnt0-1; I?buf];
            *[cnt1!=0-> O_cnt1!buf, O_ds1!buf, cnt1:=cnt1-1; I?buf];
            *[cnt2!=0-> O_cnt2!buf, O_ds2!buf, cnt2:=cnt2-1; I?buf];
            *[cnt3!=0-> O_cnt3!buf, O_ds3!buf, cnt3:=cnt3-1; I?buf];
            init:=buf=0,Cnt0?cnt0,Cnt1?cnt1,Cnt2?cnt2,Cnt3?cnt3
        ]]

    }
}

defproc Counter(
  chan(int<4>)? I;
  chan(int)! Cnt
) {

    int cnt;
    int<4> buf;

    chp{

        cnt:=0;

        *[[|
            #I-> I?buf; cnt:=cnt+buf{3}+buf{2}+buf{1}+buf{0}
            [] #Cnt-> Cnt!cnt; cnt:=0
        |]]
            
    }
}

template<pint BW>
defproc Deserializer(
    chan(int<1>)? F;
    chan(int<4>)? I;
    chan(int<BW>)! O
){

    int<4> b7,b6,b5,b4,b3,b2,b1,b0;

    chp{

        b0:=2;
        *[[#I-> I?b7; 
            [#I-> I?b6 [] #F-> b6:=0];
            [#I-> I?b5 [] #F-> b5:=0];
            [#I-> I?b4 [] #F-> b4:=0];
            [#I-> I?b3 [] #F-> b3:=0];
            [#I-> I?b2 [] #F-> b2:=0];
            [#I-> I?b1 [] #F-> b1:=0];
            [#F->F? [] ~#F->skip]; O!{b7,b6,b5,b4,b3,b2,b1,b0}
        []#F->F?]]
    }
}

template<pint BW>
defproc PayloadDispatch(
    chan(int<BW>)? I;
    chan(int<4>)? Ch;
    chan(int<BW>)! O0,O1,O2,O3
){

    int<4> ch;
    int<BW> buf;

    chp{

        *[Ch?ch, buf:=0; *[buf{0}=0-> I?buf;
            [ch{3}=1-> O0!buf [] ch{3}=0->skip],[ch{2}=1-> O1!buf [] ch{2}=0->skip],[ch{1}=1-> O2!buf [] ch{1}=0->skip],[ch{0}=1-> O3!buf [] ch{0}=0->skip]
        ]]
    }
}

template<pint BW>
defproc Merge2(
    chan(int<BW>)? I0,I1;
    chan(int<BW>)! O
){

    int<BW> buf;

    chp{
        *[[|
            #I0-> I0?buf;O!buf
            [] #I1-> I1?buf;O!buf
        |]]
    }

}

template<pint BW>
defproc MltcUnit(
  chan(int<BW>)? I;
  chan(int<BW>)! C0,C1,C2,C3
) {

    chan(int<BW>) I_ser,I_pd;
    chan(int<4>) Ch;
    chan(int<4>) I_router;
    chan(int<4>) I_cnt0,I_cnt1,I_cnt2,I_cnt3;
    chan(int) Cnt0,Cnt1,Cnt2,Cnt3;
    chan(int<4>) I_deser0,I_deser1,I_deser2,I_deser3;
    chan(int<BW>) C0_d,C1_d,C2_d,C3_d,C0_p,C1_p,C2_p,C3_p;
    chan(int<1>) F0,F1,F2,F3;

    InputRouter<BW> IR(I,I_ser,I_pd);

    Serializer<BW> SE(I_ser,I_router);

    QuadRouter QR(I_router,Cnt0,Cnt1,Cnt2,Cnt3,I_cnt0,I_cnt1,I_cnt2,I_cnt3,I_deser0,I_deser1,I_deser2,I_deser3,Ch,F0,F1,F2,F3);

    Counter CT0(I_cnt0,Cnt0);
    Counter CT1(I_cnt1,Cnt1);
    Counter CT2(I_cnt2,Cnt2);
    Counter CT3(I_cnt3,Cnt3);

    Deserializer<BW> DS0(F0,I_deser0,C0);
    Deserializer<BW> DS1(F1,I_deser1,C1);
    Deserializer<BW> DS2(F2,I_deser2,C2);
    Deserializer<BW> DS3(F3,I_deser3,C3);

    PayloadDispatch<BW> PD(I_pd,Ch,C0_p,C1_p,C2_p,C3_p);

    Merge2<BW> M0(C0_d,C0_p,C0);
    Merge2<BW> M1(C1_d,C1_p,C1);
    Merge2<BW> M2(C2_d,C2_p,C2);
    Merge2<BW> M3(C3_d,C3_p,C3);

}