import "forks/Counter/CounterLogic.act";
import "forks/Counter/CounterInc.act";
import "forks/commons/Reg8.act";

export defproc Counter(bool? reset; ActiveDualRail4? I; PassiveDualRail8! Cnt)
{
    CounterLogic logic;
    CounterInc inc;
    // Direct read request, as in Backup09062026/Forks/Counter.prs.
    Reg8<false> reg;
    logic.reset = reset;
    inc.reset = reset;
    reg.reset = reset;
    logic.I = I;
    logic.Cnt = Cnt;
    logic.P = reg.W;
    logic.Q = reg.R;
    logic.Sa = inc.Sa;
    logic.Sb = inc.Sb;
    logic.So = inc.So;
}
