import "forks/Serializer/WordBuffer.act";
import "forks/Serializer/QSlicer.act";
import "forks/Serializer/MergeTree7.act";
import "forks/commons/Seq7.act";

/* Capture all 32 input bits; serialize bits 31:28 through 7:4. */
export defproc Serializer(bool? reset; ActiveDualRail32? I; ActiveDualRail4! O)
{
    WordBuffer wb;
    QSlicer qs1, qs2, qs3, qs4, qs5, qs6, qs7;
    MergeTree7 merge;
    Seq7 seq;
    wb.reset = reset;
    seq.reset = reset;
    qs1.reset = reset;
    qs2.reset = reset;
    qs3.reset = reset;
    qs4.reset = reset;
    qs5.reset = reset;
    qs6.reset = reset;
    qs7.reset = reset;

    prs {
        // Main input and every inter-block route have a wire delay.
        I.t[0] -> wb.I.t[0]+
        ~I.t[0] -> wb.I.t[0]-
        I.f[0] -> wb.I.f[0]+
        ~I.f[0] -> wb.I.f[0]-
        I.t[1] -> wb.I.t[1]+
        ~I.t[1] -> wb.I.t[1]-
        I.f[1] -> wb.I.f[1]+
        ~I.f[1] -> wb.I.f[1]-
        I.t[2] -> wb.I.t[2]+
        ~I.t[2] -> wb.I.t[2]-
        I.f[2] -> wb.I.f[2]+
        ~I.f[2] -> wb.I.f[2]-
        I.t[3] -> wb.I.t[3]+
        ~I.t[3] -> wb.I.t[3]-
        I.f[3] -> wb.I.f[3]+
        ~I.f[3] -> wb.I.f[3]-
        I.t[4] -> wb.I.t[4]+
        ~I.t[4] -> wb.I.t[4]-
        I.f[4] -> wb.I.f[4]+
        ~I.f[4] -> wb.I.f[4]-
        I.t[5] -> wb.I.t[5]+
        ~I.t[5] -> wb.I.t[5]-
        I.f[5] -> wb.I.f[5]+
        ~I.f[5] -> wb.I.f[5]-
        I.t[6] -> wb.I.t[6]+
        ~I.t[6] -> wb.I.t[6]-
        I.f[6] -> wb.I.f[6]+
        ~I.f[6] -> wb.I.f[6]-
        I.t[7] -> wb.I.t[7]+
        ~I.t[7] -> wb.I.t[7]-
        I.f[7] -> wb.I.f[7]+
        ~I.f[7] -> wb.I.f[7]-
        I.t[8] -> wb.I.t[8]+
        ~I.t[8] -> wb.I.t[8]-
        I.f[8] -> wb.I.f[8]+
        ~I.f[8] -> wb.I.f[8]-
        I.t[9] -> wb.I.t[9]+
        ~I.t[9] -> wb.I.t[9]-
        I.f[9] -> wb.I.f[9]+
        ~I.f[9] -> wb.I.f[9]-
        I.t[10] -> wb.I.t[10]+
        ~I.t[10] -> wb.I.t[10]-
        I.f[10] -> wb.I.f[10]+
        ~I.f[10] -> wb.I.f[10]-
        I.t[11] -> wb.I.t[11]+
        ~I.t[11] -> wb.I.t[11]-
        I.f[11] -> wb.I.f[11]+
        ~I.f[11] -> wb.I.f[11]-
        I.t[12] -> wb.I.t[12]+
        ~I.t[12] -> wb.I.t[12]-
        I.f[12] -> wb.I.f[12]+
        ~I.f[12] -> wb.I.f[12]-
        I.t[13] -> wb.I.t[13]+
        ~I.t[13] -> wb.I.t[13]-
        I.f[13] -> wb.I.f[13]+
        ~I.f[13] -> wb.I.f[13]-
        I.t[14] -> wb.I.t[14]+
        ~I.t[14] -> wb.I.t[14]-
        I.f[14] -> wb.I.f[14]+
        ~I.f[14] -> wb.I.f[14]-
        I.t[15] -> wb.I.t[15]+
        ~I.t[15] -> wb.I.t[15]-
        I.f[15] -> wb.I.f[15]+
        ~I.f[15] -> wb.I.f[15]-
        I.t[16] -> wb.I.t[16]+
        ~I.t[16] -> wb.I.t[16]-
        I.f[16] -> wb.I.f[16]+
        ~I.f[16] -> wb.I.f[16]-
        I.t[17] -> wb.I.t[17]+
        ~I.t[17] -> wb.I.t[17]-
        I.f[17] -> wb.I.f[17]+
        ~I.f[17] -> wb.I.f[17]-
        I.t[18] -> wb.I.t[18]+
        ~I.t[18] -> wb.I.t[18]-
        I.f[18] -> wb.I.f[18]+
        ~I.f[18] -> wb.I.f[18]-
        I.t[19] -> wb.I.t[19]+
        ~I.t[19] -> wb.I.t[19]-
        I.f[19] -> wb.I.f[19]+
        ~I.f[19] -> wb.I.f[19]-
        I.t[20] -> wb.I.t[20]+
        ~I.t[20] -> wb.I.t[20]-
        I.f[20] -> wb.I.f[20]+
        ~I.f[20] -> wb.I.f[20]-
        I.t[21] -> wb.I.t[21]+
        ~I.t[21] -> wb.I.t[21]-
        I.f[21] -> wb.I.f[21]+
        ~I.f[21] -> wb.I.f[21]-
        I.t[22] -> wb.I.t[22]+
        ~I.t[22] -> wb.I.t[22]-
        I.f[22] -> wb.I.f[22]+
        ~I.f[22] -> wb.I.f[22]-
        I.t[23] -> wb.I.t[23]+
        ~I.t[23] -> wb.I.t[23]-
        I.f[23] -> wb.I.f[23]+
        ~I.f[23] -> wb.I.f[23]-
        I.t[24] -> wb.I.t[24]+
        ~I.t[24] -> wb.I.t[24]-
        I.f[24] -> wb.I.f[24]+
        ~I.f[24] -> wb.I.f[24]-
        I.t[25] -> wb.I.t[25]+
        ~I.t[25] -> wb.I.t[25]-
        I.f[25] -> wb.I.f[25]+
        ~I.f[25] -> wb.I.f[25]-
        I.t[26] -> wb.I.t[26]+
        ~I.t[26] -> wb.I.t[26]-
        I.f[26] -> wb.I.f[26]+
        ~I.f[26] -> wb.I.f[26]-
        I.t[27] -> wb.I.t[27]+
        ~I.t[27] -> wb.I.t[27]-
        I.f[27] -> wb.I.f[27]+
        ~I.f[27] -> wb.I.f[27]-
        I.t[28] -> wb.I.t[28]+
        ~I.t[28] -> wb.I.t[28]-
        I.f[28] -> wb.I.f[28]+
        ~I.f[28] -> wb.I.f[28]-
        I.t[29] -> wb.I.t[29]+
        ~I.t[29] -> wb.I.t[29]-
        I.f[29] -> wb.I.f[29]+
        ~I.f[29] -> wb.I.f[29]-
        I.t[30] -> wb.I.t[30]+
        ~I.t[30] -> wb.I.t[30]-
        I.f[30] -> wb.I.f[30]+
        ~I.f[30] -> wb.I.f[30]-
        I.t[31] -> wb.I.t[31]+
        ~I.t[31] -> wb.I.t[31]-
        I.f[31] -> wb.I.f[31]+
        ~I.f[31] -> wb.I.f[31]-
        wb.I.a -> I.a+
        ~wb.I.a -> I.a-

        // Existing QSlicer-to-merge/sequencer and output routes.
        wb.O1.t[0] -> qs1.I.t[0]+
        ~wb.O1.t[0] -> qs1.I.t[0]-
        qs1.O.t[0] -> merge.I0.t[0]+
        ~qs1.O.t[0] -> merge.I0.t[0]-
        wb.O1.f[0] -> qs1.I.f[0]+
        ~wb.O1.f[0] -> qs1.I.f[0]-
        qs1.O.f[0] -> merge.I0.f[0]+
        ~qs1.O.f[0] -> merge.I0.f[0]-
        wb.O1.t[1] -> qs1.I.t[1]+
        ~wb.O1.t[1] -> qs1.I.t[1]-
        qs1.O.t[1] -> merge.I0.t[1]+
        ~qs1.O.t[1] -> merge.I0.t[1]-
        wb.O1.f[1] -> qs1.I.f[1]+
        ~wb.O1.f[1] -> qs1.I.f[1]-
        qs1.O.f[1] -> merge.I0.f[1]+
        ~qs1.O.f[1] -> merge.I0.f[1]-
        wb.O1.t[2] -> qs1.I.t[2]+
        ~wb.O1.t[2] -> qs1.I.t[2]-
        qs1.O.t[2] -> merge.I0.t[2]+
        ~qs1.O.t[2] -> merge.I0.t[2]-
        wb.O1.f[2] -> qs1.I.f[2]+
        ~wb.O1.f[2] -> qs1.I.f[2]-
        qs1.O.f[2] -> merge.I0.f[2]+
        ~qs1.O.f[2] -> merge.I0.f[2]-
        wb.O1.t[3] -> qs1.I.t[3]+
        ~wb.O1.t[3] -> qs1.I.t[3]-
        qs1.O.t[3] -> merge.I0.t[3]+
        ~qs1.O.t[3] -> merge.I0.t[3]-
        wb.O1.f[3] -> qs1.I.f[3]+
        ~wb.O1.f[3] -> qs1.I.f[3]-
        qs1.O.f[3] -> merge.I0.f[3]+
        ~qs1.O.f[3] -> merge.I0.f[3]-
        qs1.I.a -> wb.O1.a+
        ~qs1.I.a -> wb.O1.a-
        merge.I0.a -> qs1.O.a+
        ~merge.I0.a -> qs1.O.a-
        seq.A6.req -> qs1.A.req+
        ~seq.A6.req -> qs1.A.req-
        qs1.A.a -> seq.A6.a+
        ~qs1.A.a -> seq.A6.a-
        wb.O2.t[0] -> qs2.I.t[0]+
        ~wb.O2.t[0] -> qs2.I.t[0]-
        qs2.O.t[0] -> merge.I1.t[0]+
        ~qs2.O.t[0] -> merge.I1.t[0]-
        wb.O2.f[0] -> qs2.I.f[0]+
        ~wb.O2.f[0] -> qs2.I.f[0]-
        qs2.O.f[0] -> merge.I1.f[0]+
        ~qs2.O.f[0] -> merge.I1.f[0]-
        wb.O2.t[1] -> qs2.I.t[1]+
        ~wb.O2.t[1] -> qs2.I.t[1]-
        qs2.O.t[1] -> merge.I1.t[1]+
        ~qs2.O.t[1] -> merge.I1.t[1]-
        wb.O2.f[1] -> qs2.I.f[1]+
        ~wb.O2.f[1] -> qs2.I.f[1]-
        qs2.O.f[1] -> merge.I1.f[1]+
        ~qs2.O.f[1] -> merge.I1.f[1]-
        wb.O2.t[2] -> qs2.I.t[2]+
        ~wb.O2.t[2] -> qs2.I.t[2]-
        qs2.O.t[2] -> merge.I1.t[2]+
        ~qs2.O.t[2] -> merge.I1.t[2]-
        wb.O2.f[2] -> qs2.I.f[2]+
        ~wb.O2.f[2] -> qs2.I.f[2]-
        qs2.O.f[2] -> merge.I1.f[2]+
        ~qs2.O.f[2] -> merge.I1.f[2]-
        wb.O2.t[3] -> qs2.I.t[3]+
        ~wb.O2.t[3] -> qs2.I.t[3]-
        qs2.O.t[3] -> merge.I1.t[3]+
        ~qs2.O.t[3] -> merge.I1.t[3]-
        wb.O2.f[3] -> qs2.I.f[3]+
        ~wb.O2.f[3] -> qs2.I.f[3]-
        qs2.O.f[3] -> merge.I1.f[3]+
        ~qs2.O.f[3] -> merge.I1.f[3]-
        qs2.I.a -> wb.O2.a+
        ~qs2.I.a -> wb.O2.a-
        merge.I1.a -> qs2.O.a+
        ~merge.I1.a -> qs2.O.a-
        seq.A5.req -> qs2.A.req+
        ~seq.A5.req -> qs2.A.req-
        qs2.A.a -> seq.A5.a+
        ~qs2.A.a -> seq.A5.a-
        wb.O3.t[0] -> qs3.I.t[0]+
        ~wb.O3.t[0] -> qs3.I.t[0]-
        qs3.O.t[0] -> merge.I2.t[0]+
        ~qs3.O.t[0] -> merge.I2.t[0]-
        wb.O3.f[0] -> qs3.I.f[0]+
        ~wb.O3.f[0] -> qs3.I.f[0]-
        qs3.O.f[0] -> merge.I2.f[0]+
        ~qs3.O.f[0] -> merge.I2.f[0]-
        wb.O3.t[1] -> qs3.I.t[1]+
        ~wb.O3.t[1] -> qs3.I.t[1]-
        qs3.O.t[1] -> merge.I2.t[1]+
        ~qs3.O.t[1] -> merge.I2.t[1]-
        wb.O3.f[1] -> qs3.I.f[1]+
        ~wb.O3.f[1] -> qs3.I.f[1]-
        qs3.O.f[1] -> merge.I2.f[1]+
        ~qs3.O.f[1] -> merge.I2.f[1]-
        wb.O3.t[2] -> qs3.I.t[2]+
        ~wb.O3.t[2] -> qs3.I.t[2]-
        qs3.O.t[2] -> merge.I2.t[2]+
        ~qs3.O.t[2] -> merge.I2.t[2]-
        wb.O3.f[2] -> qs3.I.f[2]+
        ~wb.O3.f[2] -> qs3.I.f[2]-
        qs3.O.f[2] -> merge.I2.f[2]+
        ~qs3.O.f[2] -> merge.I2.f[2]-
        wb.O3.t[3] -> qs3.I.t[3]+
        ~wb.O3.t[3] -> qs3.I.t[3]-
        qs3.O.t[3] -> merge.I2.t[3]+
        ~qs3.O.t[3] -> merge.I2.t[3]-
        wb.O3.f[3] -> qs3.I.f[3]+
        ~wb.O3.f[3] -> qs3.I.f[3]-
        qs3.O.f[3] -> merge.I2.f[3]+
        ~qs3.O.f[3] -> merge.I2.f[3]-
        qs3.I.a -> wb.O3.a+
        ~qs3.I.a -> wb.O3.a-
        merge.I2.a -> qs3.O.a+
        ~merge.I2.a -> qs3.O.a-
        seq.A4.req -> qs3.A.req+
        ~seq.A4.req -> qs3.A.req-
        qs3.A.a -> seq.A4.a+
        ~qs3.A.a -> seq.A4.a-
        wb.O4.t[0] -> qs4.I.t[0]+
        ~wb.O4.t[0] -> qs4.I.t[0]-
        qs4.O.t[0] -> merge.I3.t[0]+
        ~qs4.O.t[0] -> merge.I3.t[0]-
        wb.O4.f[0] -> qs4.I.f[0]+
        ~wb.O4.f[0] -> qs4.I.f[0]-
        qs4.O.f[0] -> merge.I3.f[0]+
        ~qs4.O.f[0] -> merge.I3.f[0]-
        wb.O4.t[1] -> qs4.I.t[1]+
        ~wb.O4.t[1] -> qs4.I.t[1]-
        qs4.O.t[1] -> merge.I3.t[1]+
        ~qs4.O.t[1] -> merge.I3.t[1]-
        wb.O4.f[1] -> qs4.I.f[1]+
        ~wb.O4.f[1] -> qs4.I.f[1]-
        qs4.O.f[1] -> merge.I3.f[1]+
        ~qs4.O.f[1] -> merge.I3.f[1]-
        wb.O4.t[2] -> qs4.I.t[2]+
        ~wb.O4.t[2] -> qs4.I.t[2]-
        qs4.O.t[2] -> merge.I3.t[2]+
        ~qs4.O.t[2] -> merge.I3.t[2]-
        wb.O4.f[2] -> qs4.I.f[2]+
        ~wb.O4.f[2] -> qs4.I.f[2]-
        qs4.O.f[2] -> merge.I3.f[2]+
        ~qs4.O.f[2] -> merge.I3.f[2]-
        wb.O4.t[3] -> qs4.I.t[3]+
        ~wb.O4.t[3] -> qs4.I.t[3]-
        qs4.O.t[3] -> merge.I3.t[3]+
        ~qs4.O.t[3] -> merge.I3.t[3]-
        wb.O4.f[3] -> qs4.I.f[3]+
        ~wb.O4.f[3] -> qs4.I.f[3]-
        qs4.O.f[3] -> merge.I3.f[3]+
        ~qs4.O.f[3] -> merge.I3.f[3]-
        qs4.I.a -> wb.O4.a+
        ~qs4.I.a -> wb.O4.a-
        merge.I3.a -> qs4.O.a+
        ~merge.I3.a -> qs4.O.a-
        seq.A3.req -> qs4.A.req+
        ~seq.A3.req -> qs4.A.req-
        qs4.A.a -> seq.A3.a+
        ~qs4.A.a -> seq.A3.a-
        wb.O5.t[0] -> qs5.I.t[0]+
        ~wb.O5.t[0] -> qs5.I.t[0]-
        qs5.O.t[0] -> merge.I4.t[0]+
        ~qs5.O.t[0] -> merge.I4.t[0]-
        wb.O5.f[0] -> qs5.I.f[0]+
        ~wb.O5.f[0] -> qs5.I.f[0]-
        qs5.O.f[0] -> merge.I4.f[0]+
        ~qs5.O.f[0] -> merge.I4.f[0]-
        wb.O5.t[1] -> qs5.I.t[1]+
        ~wb.O5.t[1] -> qs5.I.t[1]-
        qs5.O.t[1] -> merge.I4.t[1]+
        ~qs5.O.t[1] -> merge.I4.t[1]-
        wb.O5.f[1] -> qs5.I.f[1]+
        ~wb.O5.f[1] -> qs5.I.f[1]-
        qs5.O.f[1] -> merge.I4.f[1]+
        ~qs5.O.f[1] -> merge.I4.f[1]-
        wb.O5.t[2] -> qs5.I.t[2]+
        ~wb.O5.t[2] -> qs5.I.t[2]-
        qs5.O.t[2] -> merge.I4.t[2]+
        ~qs5.O.t[2] -> merge.I4.t[2]-
        wb.O5.f[2] -> qs5.I.f[2]+
        ~wb.O5.f[2] -> qs5.I.f[2]-
        qs5.O.f[2] -> merge.I4.f[2]+
        ~qs5.O.f[2] -> merge.I4.f[2]-
        wb.O5.t[3] -> qs5.I.t[3]+
        ~wb.O5.t[3] -> qs5.I.t[3]-
        qs5.O.t[3] -> merge.I4.t[3]+
        ~qs5.O.t[3] -> merge.I4.t[3]-
        wb.O5.f[3] -> qs5.I.f[3]+
        ~wb.O5.f[3] -> qs5.I.f[3]-
        qs5.O.f[3] -> merge.I4.f[3]+
        ~qs5.O.f[3] -> merge.I4.f[3]-
        qs5.I.a -> wb.O5.a+
        ~qs5.I.a -> wb.O5.a-
        merge.I4.a -> qs5.O.a+
        ~merge.I4.a -> qs5.O.a-
        seq.A2.req -> qs5.A.req+
        ~seq.A2.req -> qs5.A.req-
        qs5.A.a -> seq.A2.a+
        ~qs5.A.a -> seq.A2.a-
        wb.O6.t[0] -> qs6.I.t[0]+
        ~wb.O6.t[0] -> qs6.I.t[0]-
        qs6.O.t[0] -> merge.I5.t[0]+
        ~qs6.O.t[0] -> merge.I5.t[0]-
        wb.O6.f[0] -> qs6.I.f[0]+
        ~wb.O6.f[0] -> qs6.I.f[0]-
        qs6.O.f[0] -> merge.I5.f[0]+
        ~qs6.O.f[0] -> merge.I5.f[0]-
        wb.O6.t[1] -> qs6.I.t[1]+
        ~wb.O6.t[1] -> qs6.I.t[1]-
        qs6.O.t[1] -> merge.I5.t[1]+
        ~qs6.O.t[1] -> merge.I5.t[1]-
        wb.O6.f[1] -> qs6.I.f[1]+
        ~wb.O6.f[1] -> qs6.I.f[1]-
