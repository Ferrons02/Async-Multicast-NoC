        wb.O6.f[2] -> qs6.I.f[2]+
        ~wb.O6.f[2] -> qs6.I.f[2]-
        qs6.O.f[2] -> merge.I5.f[2]+
        ~qs6.O.f[2] -> merge.I5.f[2]-
        wb.O6.t[3] -> qs6.I.t[3]+
        ~wb.O6.t[3] -> qs6.I.t[3]-
        qs6.O.t[3] -> merge.I5.t[3]+
        ~qs6.O.t[3] -> merge.I5.t[3]-
        wb.O6.f[3] -> qs6.I.f[3]+
        ~wb.O6.f[3] -> qs6.I.f[3]-
        qs6.O.f[3] -> merge.I5.f[3]+
        ~qs6.O.f[3] -> merge.I5.f[3]-
        qs6.I.a -> wb.O6.a+
        ~qs6.I.a -> wb.O6.a-
        merge.I5.a -> qs6.O.a+
        ~merge.I5.a -> qs6.O.a-
        seq.A1.req -> qs6.A.req+
        ~seq.A1.req -> qs6.A.req-
        qs6.A.a -> seq.A1.a+
        ~qs6.A.a -> seq.A1.a-
        wb.O7.t[0] -> qs7.I.t[0]+
