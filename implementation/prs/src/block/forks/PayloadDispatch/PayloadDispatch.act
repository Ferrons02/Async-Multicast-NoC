import "forks/PayloadDispatch/ChildDispatch.act";

export defproc PayloadDispatch(
    bool? reset;
    ActiveDualRail32? I;
    ActiveDualRail4? Ch;
    ActiveDualRail32! C0;
    ActiveDualRail32! C1;
    ActiveDualRail32! C2;
    ActiveDualRail32! C3
)
{
    bool fd_cd0_C_a__Ch_a;
    bool fd_cd0_I_a__I_a;
    bool fd_cd1_C_a__Ch_a;
    bool fd_cd1_I_a__I_a;
    bool fd_cd2_C_a__Ch_a;
    bool fd_cd2_I_a__I_a;
    bool fd_cd3_C_a__Ch_a;
    bool fd_cd3_I_a__I_a;

    ChildDispatch cd0, cd1, cd2, cd3;
    cd0.reset = reset;
    cd0.C.t[0] = Ch.t[3];
    cd0.C.f[0] = Ch.f[3];
    cd0.I.t = I.t;
    cd0.I.f = I.f;
    cd0.O = C0;
    cd1.reset = reset;
    cd1.C.t[0] = Ch.t[2];
    cd1.C.f[0] = Ch.f[2];
    cd1.I.t = I.t;
    cd1.I.f = I.f;
    cd1.O = C1;
    cd2.reset = reset;
    cd2.C.t[0] = Ch.t[1];
    cd2.C.f[0] = Ch.f[1];
    cd2.I.t = I.t;
    cd2.I.f = I.f;
    cd2.O = C2;
    cd3.reset = reset;
    cd3.C.t[0] = Ch.t[0];
    cd3.C.f[0] = Ch.f[0];
    cd3.I.t = I.t;
    cd3.I.f = I.f;
    cd3.O = C3;

    // Original non-bubble PRS, PDF pp. 65–68 (existing parallel completion).
    // Reset is common; each guard pair uses one source view.
    // Only the documented fork groups share views across targets.
    prs {
        fd_cd0_I_a__I_a & fd_cd1_I_a__I_a & fd_cd2_I_a__I_a & fd_cd3_I_a__I_a -> I.a+
        ~fd_cd0_I_a__I_a & ~fd_cd1_I_a__I_a & ~fd_cd2_I_a__I_a & ~fd_cd3_I_a__I_a -> I.a-
        fd_cd0_C_a__Ch_a & fd_cd1_C_a__Ch_a & fd_cd2_C_a__Ch_a & fd_cd3_C_a__Ch_a -> Ch.a+
        ~fd_cd0_C_a__Ch_a & ~fd_cd1_C_a__Ch_a & ~fd_cd2_C_a__Ch_a & ~fd_cd3_C_a__Ch_a -> Ch.a-

        // Non-inverting wire delays.
        cd0.C.a -> fd_cd0_C_a__Ch_a+
        ~cd0.C.a -> fd_cd0_C_a__Ch_a-
        cd0.I.a -> fd_cd0_I_a__I_a+
        ~cd0.I.a -> fd_cd0_I_a__I_a-
        cd1.C.a -> fd_cd1_C_a__Ch_a+
        ~cd1.C.a -> fd_cd1_C_a__Ch_a-
        cd1.I.a -> fd_cd1_I_a__I_a+
        ~cd1.I.a -> fd_cd1_I_a__I_a-
        cd2.C.a -> fd_cd2_C_a__Ch_a+
        ~cd2.C.a -> fd_cd2_C_a__Ch_a-
        cd2.I.a -> fd_cd2_I_a__I_a+
        ~cd2.I.a -> fd_cd2_I_a__I_a-
        cd3.C.a -> fd_cd3_C_a__Ch_a+
        ~cd3.C.a -> fd_cd3_C_a__Ch_a-
        cd3.I.a -> fd_cd3_I_a__I_a+
        ~cd3.I.a -> fd_cd3_I_a__I_a-
    }
}
