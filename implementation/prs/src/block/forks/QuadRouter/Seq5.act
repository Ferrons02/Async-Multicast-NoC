import "forks/commons/Channels.act";

/* Five actions and original shared acknowledgement branches from Backup QuadRouter. */
export defproc Seq5(bool? reset; Dataless! A0; Dataless! A1; Dataless! A2; Dataless! A3; Dataless! A4)
{
    bool q0, q1, q2, q3, q4;
    bool fd_A0_a__A1_req;
    bool fd_A1_a__A2_req;
    bool fd_A2_a__A3_req;
    bool fd_A3_a__A4_req;
    bool fd_A4_a__A0_req;
    bool fd_q0__A0_req;
    bool fd_q0__q4;
    bool fd_q1__A1_req;
    bool fd_q1__q0;
    bool fd_q2__A2_req;
    bool fd_q2__q1;
    bool fd_q3__A3_req;
    bool fd_q3__q2;
    bool fd_q4__A4_req;
    bool fd_q4__q3;

    // Original non-bubble PRS, PDF pp. 51.
    // Reset is common; each guard pair uses one source view.
    // Only the documented fork groups share views across targets.
    prs {
        reset | (fd_A4_a__A0_req & ~fd_q1__q0) -> q0+
        ~reset & (~fd_A4_a__A0_req & fd_q1__q0) -> q0-
        ~reset & (fd_A0_a__A1_req & ~fd_q2__q1) -> q1+
        reset | (~fd_A0_a__A1_req & fd_q2__q1) -> q1-
        ~reset & (fd_A1_a__A2_req & ~fd_q3__q2) -> q2+
        reset | (~fd_A1_a__A2_req & fd_q3__q2) -> q2-
        ~reset & (fd_A2_a__A3_req & ~fd_q4__q3) -> q3+
        reset | (~fd_A2_a__A3_req & fd_q4__q3) -> q3-
        ~reset & (fd_A3_a__A4_req & ~fd_q0__q4) -> q4+
        reset | (~fd_A3_a__A4_req & fd_q0__q4) -> q4-
        fd_q0__A0_req & ~fd_A4_a__A0_req -> A0.req+
        ~fd_q0__A0_req -> A0.req-
        fd_q1__A1_req & ~fd_A0_a__A1_req -> A1.req+
        ~fd_q1__A1_req -> A1.req-
        fd_q2__A2_req & ~fd_A1_a__A2_req -> A2.req+
        ~fd_q2__A2_req -> A2.req-
        fd_q3__A3_req & ~fd_A2_a__A3_req -> A3.req+
        ~fd_q3__A3_req -> A3.req-
        fd_q4__A4_req & ~fd_A3_a__A4_req -> A4.req+
        ~fd_q4__A4_req -> A4.req-

        // Non-inverting wire delays.
        A0.a -> fd_A0_a__A1_req+
        ~A0.a -> fd_A0_a__A1_req-
        A1.a -> fd_A1_a__A2_req+
        ~A1.a -> fd_A1_a__A2_req-
        A2.a -> fd_A2_a__A3_req+
        ~A2.a -> fd_A2_a__A3_req-
        A3.a -> fd_A3_a__A4_req+
        ~A3.a -> fd_A3_a__A4_req-
        A4.a -> fd_A4_a__A0_req+
        ~A4.a -> fd_A4_a__A0_req-
        q0 -> fd_q0__A0_req+
        ~q0 -> fd_q0__A0_req-
        q0 -> fd_q0__q4+
        ~q0 -> fd_q0__q4-
        q1 -> fd_q1__A1_req+
        ~q1 -> fd_q1__A1_req-
        q1 -> fd_q1__q0+
        ~q1 -> fd_q1__q0-
        q2 -> fd_q2__A2_req+
        ~q2 -> fd_q2__A2_req-
        q2 -> fd_q2__q1+
        ~q2 -> fd_q2__q1-
        q3 -> fd_q3__A3_req+
        ~q3 -> fd_q3__A3_req-
        q3 -> fd_q3__q2+
        ~q3 -> fd_q3__q2-
        q4 -> fd_q4__A4_req+
        ~q4 -> fd_q4__A4_req-
        q4 -> fd_q4__q3+
        ~q4 -> fd_q4__q3-
    }
}
