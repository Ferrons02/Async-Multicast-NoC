import "forks/QuadRouter/SUpdate.act";
import "forks/QuadRouter/ChildServer.act";
import "forks/QuadRouter/QVar.act";
import "forks/commons/Merge.act";
import "forks/QuadRouter/Seq5.act";

export defproc QuadRouter(
    bool? reset;
    ActiveDualRail4? I;
    PassiveDualRail8? Cnt0;
    PassiveDualRail8? Cnt1;
    PassiveDualRail8? Cnt2;
    PassiveDualRail8? Cnt3;
    ActiveDualRail4! OC0;
    ActiveDualRail4! OC1;
    ActiveDualRail4! OC2;
    ActiveDualRail4! OC3;
    ActiveDualRail4! OD0;
    ActiveDualRail4! OD1;
    ActiveDualRail4! OD2;
    ActiveDualRail4! OD3;
    ActiveDualRail4! Ch
)
{
    bool fd_child0_I_a__I_a;
    bool fd_child1_I_a__I_a;
    bool fd_child2_I_a__I_a;
    bool fd_child3_I_a__I_a;
    bool fd_update_I_a__I_a;

    SUpdate update;
    ChildServer child0, child1, child2, child3;
    QVar q0, q1, q2, q3;
    Merge<4,false> od0, od1, od2, od3;
    Seq5 seq;
    update.reset = reset;
    update.I.t = I.t;
    update.I.f = I.f;
    update.Ch = Ch;
    update.A = seq.A0;
    seq.reset = reset;
    child0.reset = reset;
    q0.reset = reset;
    child0.I.t = I.t;
    child0.I.f = I.f;
    child0.Cnt = Cnt0;
    child0.Oc = OC0;
    child0.A = seq.A1;
    q0.W0 = update.W0;
    q0.W1 = child0.W;
    q0.R = child0.R;
    od0.I0.t = update.Od0.t;
    od0.I0.f = update.Od0.f;
    od0.I0.a = update.Od0.a;
    od0.I1.t = child0.Od.t;
    od0.I1.f = child0.Od.f;
    od0.I1.a = child0.Od.a;
    od0.O.t = OD0.t;
    od0.O.f = OD0.f;
    od0.O.a = OD0.a;
    child1.reset = reset;
    q1.reset = reset;
    child1.I.t = I.t;
    child1.I.f = I.f;
    child1.Cnt = Cnt1;
    child1.Oc = OC1;
    child1.A = seq.A2;
    q1.W0 = update.W1;
    q1.W1 = child1.W;
    q1.R = child1.R;
    od1.I0.t = update.Od1.t;
    od1.I0.f = update.Od1.f;
    od1.I0.a = update.Od1.a;
    od1.I1.t = child1.Od.t;
    od1.I1.f = child1.Od.f;
    od1.I1.a = child1.Od.a;
    od1.O.t = OD1.t;
    od1.O.f = OD1.f;
    od1.O.a = OD1.a;
    child2.reset = reset;
    q2.reset = reset;
    child2.I.t = I.t;
    child2.I.f = I.f;
    child2.Cnt = Cnt2;
    child2.Oc = OC2;
    child2.A = seq.A3;
    q2.W0 = update.W2;
    q2.W1 = child2.W;
    q2.R = child2.R;
    od2.I0.t = update.Od2.t;
    od2.I0.f = update.Od2.f;
    od2.I0.a = update.Od2.a;
    od2.I1.t = child2.Od.t;
    od2.I1.f = child2.Od.f;
    od2.I1.a = child2.Od.a;
    od2.O.t = OD2.t;
    od2.O.f = OD2.f;
    od2.O.a = OD2.a;
    child3.reset = reset;
    q3.reset = reset;
    child3.I.t = I.t;
    child3.I.f = I.f;
    child3.Cnt = Cnt3;
    child3.Oc = OC3;
    child3.A = seq.A4;
    q3.W0 = update.W3;
    q3.W1 = child3.W;
    q3.R = child3.R;
    od3.I0.t = update.Od3.t;
    od3.I0.f = update.Od3.f;
    od3.I0.a = update.Od3.a;
    od3.I1.t = child3.Od.t;
    od3.I1.f = child3.Od.f;
    od3.I1.a = child3.Od.a;
    od3.O.t = OD3.t;
    od3.O.f = OD3.f;
    od3.O.a = OD3.a;

    // Original non-bubble PRS, PDF pp. 42 (existing shared bus).
    // Reset is common; each guard pair uses one source view.
    // Only the documented fork groups share views across targets.
    prs {
        fd_update_I_a__I_a | fd_child0_I_a__I_a | fd_child1_I_a__I_a | fd_child2_I_a__I_a | fd_child3_I_a__I_a => I.a+

        // Non-inverting wire delays.
        child0.I.a -> fd_child0_I_a__I_a+
        ~child0.I.a -> fd_child0_I_a__I_a-
        child1.I.a -> fd_child1_I_a__I_a+
        ~child1.I.a -> fd_child1_I_a__I_a-
        child2.I.a -> fd_child2_I_a__I_a+
        ~child2.I.a -> fd_child2_I_a__I_a-
        child3.I.a -> fd_child3_I_a__I_a+
        ~child3.I.a -> fd_child3_I_a__I_a-
        update.I.a -> fd_update_I_a__I_a+
        ~update.I.a -> fd_update_I_a__I_a-
    }
}
