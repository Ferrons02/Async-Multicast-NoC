import "forks/commons/Channels.act";

/* Specialized full adder with the second operand fixed to one. */
export defproc FullAdderP(bool? reset; DualRailBit? a; DualRailBit? c; DualRailBit! d; DualRailBit! s)
{
    bool fd_a_f__d_f;
    bool fd_a_f__d_t;
    bool fd_a_f__s_f;
    bool fd_a_f__s_t;
    bool fd_a_t__d_f;
    bool fd_a_t__d_t;
    bool fd_a_t__s_f;
    bool fd_a_t__s_t;
    bool fd_c_f__d_f;
    bool fd_c_f__d_t;
    bool fd_c_f__s_f;
    bool fd_c_f__s_t;
    bool fd_c_t__d_f;
    bool fd_c_t__d_t;
    bool fd_c_t__s_f;
    bool fd_c_t__s_t;

    // Original non-bubble PRS, PDF pp. 52.
    // Reset is common; each guard pair uses one source view.
    // Only the documented fork groups share views across targets.
    prs {
        fd_a_t__d_t | fd_c_t__d_t -> d.t+
        ~fd_a_t__d_t & ~fd_a_f__d_t & ~fd_c_t__d_t & ~fd_c_f__d_t -> d.t-
        fd_a_f__d_f & fd_c_f__d_f -> d.f+
        ~fd_a_t__d_f & ~fd_a_f__d_f & ~fd_c_t__d_f & ~fd_c_f__d_f -> d.f-
        (fd_c_t__s_t & fd_a_t__s_t) | (fd_c_f__s_t & fd_a_f__s_t) -> s.t+
        ~fd_c_t__s_t & ~fd_c_f__s_t -> s.t-
        (fd_c_f__s_f | fd_a_f__s_f) & (fd_c_t__s_f | fd_a_t__s_f) -> s.f+
        ~fd_c_t__s_f & ~fd_c_f__s_f -> s.f-

        // Non-inverting wire delays.
        a.f -> fd_a_f__d_f+
        ~a.f -> fd_a_f__d_f-
        a.f -> fd_a_f__d_t+
        ~a.f -> fd_a_f__d_t-
        a.f -> fd_a_f__s_f+
        ~a.f -> fd_a_f__s_f-
        a.f -> fd_a_f__s_t+
        ~a.f -> fd_a_f__s_t-
        a.t -> fd_a_t__d_f+
        ~a.t -> fd_a_t__d_f-
        a.t -> fd_a_t__d_t+
        ~a.t -> fd_a_t__d_t-
        a.t -> fd_a_t__s_f+
        ~a.t -> fd_a_t__s_f-
        a.t -> fd_a_t__s_t+
        ~a.t -> fd_a_t__s_t-
        c.f -> fd_c_f__d_f+
        ~c.f -> fd_c_f__d_f-
        c.f -> fd_c_f__d_t+
        ~c.f -> fd_c_f__d_t-
        c.f -> fd_c_f__s_f+
        ~c.f -> fd_c_f__s_f-
        c.f -> fd_c_f__s_t+
        ~c.f -> fd_c_f__s_t-
        c.t -> fd_c_t__d_f+
        ~c.t -> fd_c_t__d_f-
        c.t -> fd_c_t__d_t+
        ~c.t -> fd_c_t__d_t-
        c.t -> fd_c_t__s_f+
        ~c.t -> fd_c_t__s_f-
        c.t -> fd_c_t__s_t+
        ~c.t -> fd_c_t__s_t-
    }
}
