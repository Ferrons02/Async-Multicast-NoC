import "no_forks/commons/Channels.act";

// O7 carries bits 31:28, down to O1 carrying bits 7:4.
// All 32 input bits participate in capture and spacer detection.
export defproc WordBuffer(bool? reset; ActiveDualRail32? I;
    ActiveDualRail4! O1, O2, O3, O4, O5, O6, O7)
{
    bool b[32], v;
    bool u1, u2, u3, u4, u5, u6, u7;

    // Each u records its slice acknowledge until the input handshake clears it.
    prs {
        (&i:32: ((I.t[i] & b[i]) | (I.f[i] & ~b[i]))) -> v+
        ((&i:32: (~I.t[i] & ~I.f[i])) &
            ~u7 & ~u6 & ~u5 & ~u4 & ~u3 & ~u2 & ~u1) | reset -> v-
        u1 & ~O1.a -> I.a+
        ~v -> I.a-
        (i:32:
            ~v & I.t[i] -> b[i]+
            (~v & I.f[i]) | reset -> b[i]-
        )

        // Remember which slices have been served.
        O7.a -> u7+
        I.a | reset -> u7-
        O6.a -> u6+
        I.a | reset -> u6-
        O5.a -> u5+
        I.a | reset -> u5-
        O4.a -> u4+
        I.a | reset -> u4-
        O3.a -> u3+
        I.a | reset -> u3-
        O2.a -> u2+
        I.a | reset -> u2-
        O1.a -> u1+
        I.a | reset -> u1-

        // Bits 31:28.
        (i:4:
            ~u7 & v & ~I.a & b[28+i] -> O7.t[i]+
            u7 | reset -> O7.t[i]-
            ~u7 & v & ~I.a & ~b[28+i] -> O7.f[i]+
            u7 | reset -> O7.f[i]-
        )
        // Bits 27:24.
        (i:4:
            ~u6 & v & ~I.a & b[24+i] -> O6.t[i]+
            u6 | reset -> O6.t[i]-
            ~u6 & v & ~I.a & ~b[24+i] -> O6.f[i]+
            u6 | reset -> O6.f[i]-
        )
        // Bits 23:20.
        (i:4:
            ~u5 & v & ~I.a & b[20+i] -> O5.t[i]+
            u5 | reset -> O5.t[i]-
            ~u5 & v & ~I.a & ~b[20+i] -> O5.f[i]+
            u5 | reset -> O5.f[i]-
        )
        // Bits 19:16.
        (i:4:
            ~u4 & v & ~I.a & b[16+i] -> O4.t[i]+
            u4 | reset -> O4.t[i]-
            ~u4 & v & ~I.a & ~b[16+i] -> O4.f[i]+
            u4 | reset -> O4.f[i]-
        )
        // Bits 15:12.
        (i:4:
            ~u3 & v & ~I.a & b[12+i] -> O3.t[i]+
            u3 | reset -> O3.t[i]-
            ~u3 & v & ~I.a & ~b[12+i] -> O3.f[i]+
            u3 | reset -> O3.f[i]-
        )
        // Bits 11:8.
        (i:4:
            ~u2 & v & ~I.a & b[8+i] -> O2.t[i]+
            u2 | reset -> O2.t[i]-
            ~u2 & v & ~I.a & ~b[8+i] -> O2.f[i]+
            u2 | reset -> O2.f[i]-
        )
        // Bits 7:4.
        (i:4:
            ~u1 & v & ~I.a & b[4+i] -> O1.t[i]+
            u1 | reset -> O1.t[i]-
            ~u1 & v & ~I.a & ~b[4+i] -> O1.f[i]+
            u1 | reset -> O1.f[i]-
        )
    }
}
