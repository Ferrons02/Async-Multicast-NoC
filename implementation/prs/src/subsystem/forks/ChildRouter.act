import "forks/StopcodeSel/StopcodeSel.act";
import "forks/UpdownSel/UpdownSel.act";
import "forks/ChildSel/ChildSel.act";

/*
 * Topology and instance names follow src/ChildRouter.png.
 * CS.O0..O3 connect to C0..C3 by index; ChildSel leaves are O3,O2,O1,O0.
 * ACT_PATH must include src/block. Reset is shared directly, as in the blocks.
 * Every channel wire at this level, including external ports, has a CMOS inverter pair
 * implementing its transport buffer: t/f follow the data direction; a/req travel in the reverse direction.
 * Both transitions use the same source, following the existing fork-delay style.
 */
export defproc ChildRouter(
    bool? reset;
    ActiveDualRail32? I;
    ActiveDualRail32! M, P, C0, C1, C2, C3
)
{
    /* Logical holding-state senses are unchanged.
     * Channel restoring inverters retain the public active-high encoding.
     * inv_* nodes are combinational complements, not additional HSE state. */
    bool inv_C0_a;
    bool inv_C1_a;
    bool inv_C2_a;
    bool inv_C3_a;
    bool inv_CS_I_a;
    bool inv_CS_O0_f[32];
    bool inv_CS_O0_t[32];
    bool inv_CS_O1_f[32];
    bool inv_CS_O1_t[32];
    bool inv_CS_O2_f[32];
    bool inv_CS_O2_t[32];
    bool inv_CS_O3_f[32];
    bool inv_CS_O3_t[32];
    bool inv_I_f[32];
    bool inv_I_t[32];
    bool inv_M_a;
    bool inv_P_a;
    bool inv_SS_I_a;
    bool inv_SS_O0_f[32];
    bool inv_SS_O0_t[32];
    bool inv_SS_O1_f[32];
    bool inv_SS_O1_t[32];
    bool inv_US_I_a;
    bool inv_US_O0_f[32];
    bool inv_US_O0_t[32];
    bool inv_US_O1_f[32];
    bool inv_US_O1_t[32];

    StopcodeSel SS;
    UpdownSel US;
    ChildSel CS;

    SS.reset = reset;
    US.reset = reset;
    CS.reset = reset;

    prs {
        // Input to stopcode selector.
        (i:32:
            ~inv_I_t[i] -> SS.I.t[i]+
            inv_I_t[i] -> SS.I.t[i]-
            ~inv_I_f[i] -> SS.I.f[i]+
            inv_I_f[i] -> SS.I.f[i]-
        )
        ~inv_SS_I_a -> I.a+
        inv_SS_I_a -> I.a-

        // Stopcode detected: multicast output.
        (i:32:
            ~inv_SS_O0_t[i] -> M.t[i]+
            inv_SS_O0_t[i] -> M.t[i]-
            ~inv_SS_O0_f[i] -> M.f[i]+
            inv_SS_O0_f[i] -> M.f[i]-
        )
        ~inv_M_a -> SS.O0.a+
        inv_M_a -> SS.O0.a-

        // No stopcode: select up or down.
        (i:32:
            ~inv_SS_O1_t[i] -> US.I.t[i]+
            inv_SS_O1_t[i] -> US.I.t[i]-
            ~inv_SS_O1_f[i] -> US.I.f[i]+
            inv_SS_O1_f[i] -> US.I.f[i]-
        )
        ~inv_US_I_a -> SS.O1.a+
        inv_US_I_a -> SS.O1.a-

        // Up: parent output.
        (i:32:
            ~inv_US_O0_t[i] -> P.t[i]+
            inv_US_O0_t[i] -> P.t[i]-
            ~inv_US_O0_f[i] -> P.f[i]+
            inv_US_O0_f[i] -> P.f[i]-
        )
        ~inv_P_a -> US.O0.a+
        inv_P_a -> US.O0.a-

        // Down: select a child.
        (i:32:
            ~inv_US_O1_t[i] -> CS.I.t[i]+
            inv_US_O1_t[i] -> CS.I.t[i]-
            ~inv_US_O1_f[i] -> CS.I.f[i]+
            inv_US_O1_f[i] -> CS.I.f[i]-
        )
        ~inv_CS_I_a -> US.O1.a+
        inv_CS_I_a -> US.O1.a-

        // Child 0.
        (i:32:
            ~inv_CS_O0_t[i] -> C0.t[i]+
            inv_CS_O0_t[i] -> C0.t[i]-
            ~inv_CS_O0_f[i] -> C0.f[i]+
            inv_CS_O0_f[i] -> C0.f[i]-
        )
        ~inv_C0_a -> CS.O0.a+
        inv_C0_a -> CS.O0.a-

        // Child 1.
        (i:32:
            ~inv_CS_O1_t[i] -> C1.t[i]+
            inv_CS_O1_t[i] -> C1.t[i]-
            ~inv_CS_O1_f[i] -> C1.f[i]+
            inv_CS_O1_f[i] -> C1.f[i]-
        )
        ~inv_C1_a -> CS.O1.a+
        inv_C1_a -> CS.O1.a-

        // Child 2.
        (i:32:
            ~inv_CS_O2_t[i] -> C2.t[i]+
            inv_CS_O2_t[i] -> C2.t[i]-
            ~inv_CS_O2_f[i] -> C2.f[i]+
            inv_CS_O2_f[i] -> C2.f[i]-
        )
        ~inv_C2_a -> CS.O2.a+
        inv_C2_a -> CS.O2.a-

        // Child 3.
        (i:32:
            ~inv_CS_O3_t[i] -> C3.t[i]+
            inv_CS_O3_t[i] -> C3.t[i]-
            ~inv_CS_O3_f[i] -> C3.f[i]+
            inv_CS_O3_f[i] -> C3.f[i]-
        )
        ~inv_C3_a -> CS.O3.a+
        inv_C3_a -> CS.O3.a-
    }

    // Residual CMOS inverters; no independent HSE sequencing state.
    prs {
        ~C0.a => inv_C0_a+
        ~C1.a => inv_C1_a+
        ~C2.a => inv_C2_a+
        ~C3.a => inv_C3_a+
        ~CS.I.a => inv_CS_I_a+
        (bi:32: ~CS.O0.f[bi] => inv_CS_O0_f[bi]+)
        (bi:32: ~CS.O0.t[bi] => inv_CS_O0_t[bi]+)
        (bi:32: ~CS.O1.f[bi] => inv_CS_O1_f[bi]+)
        (bi:32: ~CS.O1.t[bi] => inv_CS_O1_t[bi]+)
        (bi:32: ~CS.O2.f[bi] => inv_CS_O2_f[bi]+)
        (bi:32: ~CS.O2.t[bi] => inv_CS_O2_t[bi]+)
        (bi:32: ~CS.O3.f[bi] => inv_CS_O3_f[bi]+)
        (bi:32: ~CS.O3.t[bi] => inv_CS_O3_t[bi]+)
        (bi:32: ~I.f[bi] => inv_I_f[bi]+)
        (bi:32: ~I.t[bi] => inv_I_t[bi]+)
        ~M.a => inv_M_a+
        ~P.a => inv_P_a+
        ~SS.I.a => inv_SS_I_a+
        (bi:32: ~SS.O0.f[bi] => inv_SS_O0_f[bi]+)
        (bi:32: ~SS.O0.t[bi] => inv_SS_O0_t[bi]+)
        (bi:32: ~SS.O1.f[bi] => inv_SS_O1_f[bi]+)
        (bi:32: ~SS.O1.t[bi] => inv_SS_O1_t[bi]+)
        ~US.I.a => inv_US_I_a+
        (bi:32: ~US.O0.f[bi] => inv_US_O0_f[bi]+)
        (bi:32: ~US.O0.t[bi] => inv_US_O0_t[bi]+)
        (bi:32: ~US.O1.f[bi] => inv_US_O1_f[bi]+)
        (bi:32: ~US.O1.t[bi] => inv_US_O1_t[bi]+)
    }
}
