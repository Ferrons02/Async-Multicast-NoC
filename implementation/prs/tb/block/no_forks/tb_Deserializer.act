import "../../../src/block/no_forks/Deserializer/Deserializer.act";
import "../testbench_support.act";

/* Fixed stimulus and immediate per-receive checks from BLOCK_TESTBENCH_PLAN.md. */
/* Global controls avoid an actsim state-offset bug for parent-owned CHP
 * Boolean ports beside the PRS hierarchy. The command file uses these names. */
bool reset, stop, fail, done, ready;
int<32> rounds;
Initialize { actions { ready- } }
bool bad[1];
TbPush<4> I;
TbPush<32> O;

defproc DeserializerDriver(
    bool bad_O;
    TbPush!<4> I;
    TbPush?<32> O
)
{
    /* ACT disallows nonlocal ports directly in loop guards. Sample the
     * external stop/fail flags at each completed sequence boundary. */
    bool running;
    int<32> out_O;
    chp {
        ready := false; stop := false; done := false; rounds := 0;
        bad_O := false;
        ready := true; running := true;
        [~reset];
        *[running ->
            ((
            I!0xF;
            I!0xF;
            I!0;
            I!0;
            I!0;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0xF;
            I!0
            ),(
            O?out_O;
            [out_O != 0xFF000002 ->
                bad_O := true;
                log("FAILED: O expected ", 0xFF000002, ", got ", out_O, ", round ", rounds);
                assert(out_O = 0xFF000002, "O golden mismatch");
                [reset]
            [] else -> skip];
            O?out_O;
            [out_O != 0xFFFFFFF2 ->
                bad_O := true;
                log("FAILED: O expected ", 0xFFFFFFF2, ", got ", out_O, ", round ", rounds);
                assert(out_O = 0xFFFFFFF2, "O golden mismatch");
                [reset]
            [] else -> skip];
            O?out_O;
            [out_O != 0xFFF00002 ->
                bad_O := true;
                log("FAILED: O expected ", 0xFFF00002, ", got ", out_O, ", round ", rounds);
                assert(out_O = 0xFFF00002, "O golden mismatch");
                [reset]
            [] else -> skip]
            ));
            rounds := rounds + 1;
            [stop | fail -> running := false [] else -> skip]
        ];
        done := true;
        [fail -> log("FAILED")
        [] else -> log("PASSED: rounds=", rounds)]
    }
}

defproc tb_Deserializer()
{
    Deserializer dut;
    dut.reset = reset;
    TbPushSender<4> wire_I(I, dut.I.t, dut.I.f, dut.I.a);
    TbPushReceiver<32> wire_O(O, dut.O.t, dut.O.f, dut.O.a);
    TbFailure<1> failure(ready, bad, fail);
    DeserializerDriver driver(bad[0], I, O);
}
