import "../../../src/block/forks/UpdownSel/UpdownSel.act";
import "../testbench_support.act";

/* Current UpdownSel shifts bits 31..13, retaining the high three ones.
 * The plan spells this UpDownSel and gives 1FFFDFFE; source gives FFFFDFFE. */
/* Global controls avoid an actsim state-offset bug for parent-owned CHP
 * Boolean ports beside the PRS hierarchy. The command file uses these names. */
bool reset, stop, fail, done, ready;
int<32> rounds;
Initialize { actions { ready- } }
bool bad[2];
TbPush<32> I;
TbPush<32> O0;
TbPush<32> O1;

defproc UpdownSelDriver(
    bool bad_O0, bad_O1;
    TbPush!<32> I;
    TbPush?<32> O0;
    TbPush?<32> O1
)
{
    /* ACT disallows nonlocal ports directly in loop guards. Sample the
     * external stop/fail flags at each completed sequence boundary. */
    bool running;
    int<32> out_O0;
    int<32> out_O1;
    chp {
        ready := false; stop := false; done := false; rounds := 0;
        bad_O0 := false; bad_O1 := false;
        ready := true; running := true;
        [~reset];
        *[running ->
            ((
            I!0xFFFFFFFE;
            I!0x0FFFFFFE;
            I!0xFFFFFFFF;
            I!0x7FFFFFFE;
            I!0x1FFFFFFE;
            I!0xFFFFFFFF
            ),(
            O0?out_O0;
            [out_O0 != 0xFFFFDFFE ->
                bad_O0 := true;
                log("FAILED: O0 expected ", 0xFFFFDFFE, ", got ", out_O0, ", round ", rounds);
                assert(out_O0 = 0xFFFFDFFE, "O0 golden mismatch");
                [reset]
            [] else -> skip];
            O0?out_O0;
            [out_O0 != 0x0FFFFFFE ->
                bad_O0 := true;
                log("FAILED: O0 expected ", 0x0FFFFFFE, ", got ", out_O0, ", round ", rounds);
                assert(out_O0 = 0x0FFFFFFE, "O0 golden mismatch");
                [reset]
            [] else -> skip];
            O0?out_O0;
            [out_O0 != 0xFFFFFFFF ->
                bad_O0 := true;
                log("FAILED: O0 expected ", 0xFFFFFFFF, ", got ", out_O0, ", round ", rounds);
                assert(out_O0 = 0xFFFFFFFF, "O0 golden mismatch");
                [reset]
            [] else -> skip]
            ),(
            O1?out_O1;
            [out_O1 != 0xFFFFDFFE ->
                bad_O1 := true;
                log("FAILED: O1 expected ", 0xFFFFDFFE, ", got ", out_O1, ", round ", rounds);
                assert(out_O1 = 0xFFFFDFFE, "O1 golden mismatch");
                [reset]
            [] else -> skip];
            O1?out_O1;
            [out_O1 != 0x1FFFFFFE ->
                bad_O1 := true;
                log("FAILED: O1 expected ", 0x1FFFFFFE, ", got ", out_O1, ", round ", rounds);
                assert(out_O1 = 0x1FFFFFFE, "O1 golden mismatch");
                [reset]
            [] else -> skip];
            O1?out_O1;
            [out_O1 != 0xFFFFFFFF ->
                bad_O1 := true;
                log("FAILED: O1 expected ", 0xFFFFFFFF, ", got ", out_O1, ", round ", rounds);
                assert(out_O1 = 0xFFFFFFFF, "O1 golden mismatch");
                [reset]
            [] else -> skip]
            ));
            rounds := rounds + 1;
            [stop | fail -> running := false [] else -> skip]
        ];
        done := true;
        [fail -> log("FAILED")
        [] else -> log("PASSED: rounds=", rounds)]
    }
}

defproc tb_UpdownSel()
{
    UpdownSel dut;
    dut.reset = reset;
    TbPushSender<32> wire_I(I, dut.I.t, dut.I.f, dut.I.a);
    TbPushReceiver<32> wire_O0(O0, dut.O0.t, dut.O0.f, dut.O0.a);
    TbPushReceiver<32> wire_O1(O1, dut.O1.t, dut.O1.f, dut.O1.a);
    TbFailure<2> failure(ready, bad, fail);
    UpdownSelDriver driver(bad[0], bad[1], I, O0, O1);
}
