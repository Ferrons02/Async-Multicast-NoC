import "commons/PCFB32.act";
import "MltcSel/MltcSel.act";
import "StopcodeSel/StopcodeSel.act";
import "ChildSel/ChildSel.act";
import "commons/Merge.act";

/*
 * Topology and instance names follow src/ParentRouter.png.
 * Merge<32,true> uses bit 31 for acknowledgement and releases it on ~O.a.
 * CS.O0..O3 connect to C0..C3 by port name; ChildSel keeps its existing leaf mapping.
 * ACT_PATH must include src/block. Reset is shared directly, as in the blocks.
 */
export defproc ParentRouter(
    bool? reset;
    ActiveDualRail32? I;
    ActiveDualRail32! M, C0, C1, C2, C3
)
{
    // Pipeline stages at the red bars in ParentRouterPipelined.png.
    PCFB32 BUS;
    BUS.reset = reset;
    PCFB32 BSC;
    BSC.reset = reset;
    PCFB32 BC0;
    BC0.reset = reset;
    PCFB32 BC1;
    BC1.reset = reset;
    PCFB32 BC2;
    BC2.reset = reset;
    PCFB32 BC3;
    BC3.reset = reset;

    PCFB32 BM0;
    BM0.reset = reset;
    PCFB32 BM1;
    BM1.reset = reset;
    PCFB32 BM;
    BM.reset = reset;

    MltcSel MUS;
    StopcodeSel SS;
    ChildSel CS;
    Merge<32,true> M2;

    MUS.reset = reset;
    SS.reset = reset;
    CS.reset = reset;

    // Input to multicast selector.
    MUS.I = I;

    // mltc=1: first merge input.
    BM0.L.t = MUS.O0.t;
    BM0.R.t = M2.I0.t;
    BM0.L.f = MUS.O0.f;
    BM0.R.f = M2.I0.f;
    BM0.L.a = MUS.O0.a;
    BM0.R.a = M2.I0.a;

    // mltc=0: test the stopcode.
    BUS.L = MUS.O1;
    BUS.R = SS.I;

    // USCODE detected: second merge input.
    BM1.L.t = SS.O0.t;
    BM1.R.t = M2.I1.t;
    BM1.L.f = SS.O0.f;
    BM1.R.f = M2.I1.f;
    BM1.L.a = SS.O0.a;
    BM1.R.a = M2.I1.a;

    // No USCODE: select a child.
    BSC.L = SS.O1;
    BSC.R = CS.I;

    // Merged multicast output.
    BM.L.t = M2.O.t;
    BM.R.t = M.t;
    BM.L.f = M2.O.f;
    BM.R.f = M.f;
    BM.L.a = M2.O.a;
    BM.R.a = M.a;

    // Child 0.
    BC0.L = CS.O0;
    BC0.R = C0;

    // Child 1.
    BC1.L = CS.O1;
    BC1.R = C1;

    // Child 2.
    BC2.L = CS.O2;
    BC2.R = C2;

    // Child 3.
    BC3.L = CS.O3;
    BC3.R = C3;
}
