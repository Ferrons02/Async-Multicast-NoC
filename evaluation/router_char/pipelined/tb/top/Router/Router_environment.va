analog begin
  @(initial_step) begin
    active=0; finished=0; failure=0; tx=0; phase=0; ready=0;
    idle_started=0; idle_completed=0; idle_start=-1; round_time=-1; issued=0; source_checked=0; failure_stop=-1;
    threshold=SUPPLY/2;
    for (j=0;j<5;j=j+1) begin tx_valid[j]=0; tx_word[j]=0; ack[j]=0; rx_phase[j]=0; rx_index[j]=0; end
    for (k=0;k<40;k=k+1) begin
      if (((stimulus(k) >> 16) & 65535)!=stimulus_hi(k) || (stimulus(k) & 65535)!=stimulus_lo(k)) begin
        failure=1; $display("SIM_ERROR t=%e reason=constant_encoding table=stimulus index=%d",$abstime,k);
      end
    end
    for (k=0;k<40;k=k+1) begin
      if (((source(k) >> 16) & 65535)!=source_hi(k) || (source(k) & 65535)!=source_lo(k)) begin
