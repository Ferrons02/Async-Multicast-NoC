            else $display("SIM_IACK_HIGH t=%e channel=I step=%d",$abstime,tx_step);
          end
        end else if (tx_phase==2 && producer_ack < threshold && input_spacer && control_spacer) begin
          if (control_step) $display("SIM_IACK_LOW t=%e channel=Ch step=%d",$abstime,tx_step);
          else $display("SIM_IACK_LOW t=%e channel=I step=%d",$abstime,tx_step);
          tx_step=tx_step+1; tx_phase=0;
        end
        if (!failure && tx_step==6 && rx_index0==4 && rx_index1==1 && rx_index2==4 && rx_index3==1 &&
