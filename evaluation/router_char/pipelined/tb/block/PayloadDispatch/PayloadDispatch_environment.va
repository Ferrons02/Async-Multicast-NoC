            failure=1; $display("SIM_ERROR t=%e reason=word_changed_without_spacer channel=C0",$abstime);
          end else if (!valid0 && V(C0_a) < threshold) begin
            failure=1; $display("SIM_ERROR t=%e reason=data_withdrawn_before_ack channel=C0",$abstime);
          end else if (spacer0 && V(C0_a) >= threshold) begin
