  @(timer(STOP_TIME-4*TD-4*EDGE)) begin
    if (!finished && !failure) begin
      failure=1;
      $display("SIM_ERROR t=%e reason=timeout step=%d tx_phase=%d rx=%d,%d,%d,%d I.a=%e Ch.a=%e",$abstime,tx_step,tx_phase,rx_index0,rx_index1,rx_index2,rx_index3,V(I_a),V(Ch_a));
    end
  end
  V(I_t_0) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 0) & 1),TD,EDGE,EDGE);
  V(I_f_0) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 0) & 1)),TD,EDGE,EDGE);
  V(I_t_1) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 1) & 1),TD,EDGE,EDGE);
  V(I_f_1) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 1) & 1)),TD,EDGE,EDGE);
  V(I_t_2) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 2) & 1),TD,EDGE,EDGE);
  V(I_f_2) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 2) & 1)),TD,EDGE,EDGE);
  V(I_t_3) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 3) & 1),TD,EDGE,EDGE);
  V(I_f_3) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 3) & 1)),TD,EDGE,EDGE);
  V(I_t_4) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 4) & 1),TD,EDGE,EDGE);
  V(I_f_4) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 4) & 1)),TD,EDGE,EDGE);
  V(I_t_5) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 5) & 1),TD,EDGE,EDGE);
  V(I_f_5) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 5) & 1)),TD,EDGE,EDGE);
  V(I_t_6) <+ transition(SUPPLY*tx_i_valid*((tx_lo >> 6) & 1),TD,EDGE,EDGE);
  V(I_f_6) <+ transition(SUPPLY*tx_i_valid*(1-((tx_lo >> 6) & 1)),TD,EDGE,EDGE);
