      end
      if (!failure) begin
        if (rx_phase0 == 0 && valid0 && !spacer0) begin
          if (rx_index0 >= 4) begin
            failure=1; $display("SIM_ERROR t=%e reason=unexpected_output channel=C0 index=%d step=%d",$abstime,rx_index0,tx_step);
          end else begin
            expected0_hi=65535; expected0_lo=65535; if (rx_index0<2) expected0_lo=65534;
            if (word0_hi != expected0_hi || word0_lo != expected0_lo) begin
              failure=1;
