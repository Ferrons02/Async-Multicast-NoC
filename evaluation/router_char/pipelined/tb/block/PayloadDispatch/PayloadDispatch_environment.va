      if (failure) $display("SIM_FAIL t=%e reason=see_SIM_ERROR",$abstime);
      else $display("SIM_PASS t=%e rounds=1 controls=2 inputs=4 C0=4 C1=1 C2=4 C3=1",$abstime);
      $finish(0);
    end
