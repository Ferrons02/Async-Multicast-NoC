        end else if (tx_phase_C0 == 2 && V(C0_a) < threshold && input_spacer_C0) begin
          $display("SIM_IACK_LOW t=%e channel=C0 index=%d",$abstime,tx_index_C0);
          tx_index_C0=tx_index_C0+1; tx_phase_C0=0;
