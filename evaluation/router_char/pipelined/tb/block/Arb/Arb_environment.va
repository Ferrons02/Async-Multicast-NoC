analog function integer stimulus_hi;
  input port, index;
  integer port, index;
  begin
    if (index < 2) stimulus_hi=65535;
    else stimulus_hi=4096+32*port+index;
  end
endfunction
analog function integer stimulus_lo;
  input port, index;
  integer port, index;
  begin
    case (index)
      0: stimulus_lo=65534;
      1: stimulus_lo=65535;
      2: stimulus_lo=21930; // 55AA: header, bit 0 low
      3: stimulus_lo=43604; // AA54: nonterminal payload, bit 0 low
      4: stimulus_lo=21931; // 55AB: terminal payload, bit 0 high
      default: stimulus_lo=0;
    endcase
  end
endfunction
