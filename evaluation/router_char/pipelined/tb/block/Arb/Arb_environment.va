      if (!failure) begin
        if (rx_phase == 0 && valid && !spacer) begin
          if (rx_index >= 30) begin
            failure=1; $display("SIM_ERROR t=%e reason=unexpected_output channel=O",$abstime);
          end else begin
            if (rx_index < 12) begin
              expected_hi=65535;
              if ((rx_index % 2) == 0) expected_lo=65534;
              else expected_lo=65535;
            end else begin
              expected_hi=stimulus_hi((rx_index-12)/3, 2+(rx_index-12)%3);
              expected_lo=stimulus_lo((rx_index-12)/3, 2+(rx_index-12)%3);
            end
            if (actual_hi != expected_hi || actual_lo != expected_lo) begin
              failure=1;
