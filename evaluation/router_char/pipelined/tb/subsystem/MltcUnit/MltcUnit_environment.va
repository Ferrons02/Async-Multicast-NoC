// Supply-current sampling continues after the functional round, with reset low.
parameter real IDLE_SETTLE=20n from (0:inf);
parameter real IDLE_WINDOW=20n from (0:inf);
parameter real IDLE_MARGIN=1n from (0:inf);
integer idle_started, idle_completed;
real idle_start;
analog begin
  @(initial_step) begin
    idle_start=-1; idle_started=0; idle_completed=0;
    active=0; finished=0; failure=0; reported=0;
    gap_start=-1; energy_ended=0;
    threshold=0.5*SUPPLY; stop_after=-1; release_time=-1;
    for (j=0;j<1;j=j+1) begin tx_index[j]=0; tx_phase[j]=0; tx_valid[j]=0; tx_word[j]=0; end
    for (j=0;j<4;j=j+1) begin rx_index[j]=0; rx_phase[j]=0; ack[j]=0; held[j]=0; end
    for (j=0;j<4;j=j+1) expected[j]=0;
    if (SUPPLY<=0) begin failure=1; $display("SIM_ERROR reason=invalid_supply"); end
  end
