  V(I_f_31) <+ transition(SUPPLY*tx_valid[0]*(1-((tx_word[0] >> 31) & 1)),TD,EDGE,EDGE);
  V(C0_a) <+ transition(SUPPLY*ack[0],TD,EDGE,EDGE);
  V(C1_a) <+ transition(SUPPLY*ack[1],TD,EDGE,EDGE);
  V(C2_a) <+ transition(SUPPLY*ack[2],TD,EDGE,EDGE);
  V(C3_a) <+ transition(SUPPLY*ack[3],TD,EDGE,EDGE);
  V(done) <+ transition(SUPPLY*finished,0,EDGE,EDGE);
  V(failed) <+ transition(SUPPLY*failure,0,EDGE,EDGE);
