    if (V(C3_t_31)>=threshold) word[3]=word[3] | (1 << 31);
    if (!active && !finished && !failure && V(reset)<threshold) begin
      active=1; release_time=$abstime; $display("SIM_RESET t=%e",$abstime);
      $display("SIM_PROTOCOL name=mltc_pcfb_payload_v1");
    end
    if (active && !failure) begin
      if (illegal[0]) begin failure=1; $display("SIM_ERROR t=%e reason=illegal_dual_rail channel=C0",$abstime); end
      if (!failure && rx_phase[0]==0 && valid_word[0]) begin
        held[0]=word[0];
        expected[0]=golden(0,rx_index[0]);
        if (rx_index[0]>=2) begin failure=1; $display("SIM_ERROR t=%e reason=unexpected_output channel=C0",$abstime); end
        else if (word[0]!=expected[0]) begin
          failure=1;
          $display("SIM_RX t=%e channel=C0 index=%d expected=%h actual=%h FAIL",$abstime,rx_index[0],expected[0],word[0]);
          $display("SIM_ERROR t=%e reason=golden_mismatch",$abstime);
        end else begin
          $display("SIM_RX t=%e channel=C0 index=%d expected=%h actual=%h PASS",$abstime,rx_index[0],expected[0],word[0]);
        end
        if (!failure) begin ack[0]=1; rx_phase[0]=1; end
      end else if (!failure && rx_phase[0]==1) begin
        if (valid_word[0] && word[0]!=held[0]) begin failure=1; $display("SIM_ERROR t=%e reason=word_changed_without_spacer channel=C0",$abstime); end
        else if (!valid_word[0] && V(C0_a)<threshold) begin failure=1; $display("SIM_ERROR t=%e reason=data_withdrawn_before_ack channel=C0",$abstime); end
