      end else if (!failure && tx_phase[0]==2 && V(I_a)<threshold && input_spacer[0]) begin
        $display("SIM_IACK_LOW t=%e channel=I index=%d",$abstime,tx_index[0]);
        tx_index[0]=tx_index[0]+1; tx_phase[0]=0;
      end
      // Saturated payload burst; pauses only isolate the route and energy experiment.
      launch_ok=1;
      outputs_idle=(rx_phase[0]==0 && rx_phase[1]==0 && rx_phase[2]==0 && rx_phase[3]==0);
      if (tx_index[0]==14 || tx_index[0]==16 || tx_index[0]==24 || tx_index[0]==25) begin
        launch_ok=0;
        gap_ready=outputs_idle && tx_phase[0]==0;
        if (tx_index[0]==14 && (rx_index[2]!=11 || rx_index[3]!=11)) gap_ready=0;
        if (tx_index[0]==16 && (rx_index[2]!=12 || rx_index[3]!=12)) gap_ready=0;
        if (tx_index[0]==24 && (rx_index[2]!=20 || rx_index[3]!=20)) gap_ready=0;
        if (tx_index[0]==25 && (rx_index[2]!=21 || rx_index[3]!=21)) gap_ready=0;
        if (gap_ready) begin
          if (gap_start<0) gap_start=$abstime;
          if ($abstime>=gap_start+20n) begin
            launch_ok=1;
            if (tx_index[0]==25) begin
              if (!energy_ended) begin
                energy_ended=1;
                $display("SIM_ENERGY_END t=%e input_index=24",$abstime);
              end
              if ($abstime<gap_start+30n) launch_ok=0;
            end
          end
        end
      end
      if (!failure && launch_ok && tx_phase[0]==0 && tx_index[0]<26 && V(I_a)<threshold && input_spacer[0] && $abstime>=release_time+0*TICK) begin
        gap_start=-1;
        if (tx_index[0]==16) $display("SIM_BURST_BEGIN t=%e input_index=16",$abstime);
        if (tx_index[0]==24) $display("SIM_ENERGY_BEGIN t=%e input_index=24",$abstime);
        tx_word[0]=stimulus(0,tx_index[0]); tx_valid[0]=1; tx_phase[0]=1;
        $display("SIM_TX t=%e channel=I index=%d word=%h",$abstime,tx_index[0],tx_word[0]);
      end
    end
    all_complete=1; quiescent=1;
    if (tx_index[0]!=26 || tx_phase[0]!=0) all_complete=0;
    if (!input_spacer[0] || V(I_a)>=threshold) quiescent=0;
    if (rx_index[0]!=2 || rx_phase[0]!=0) all_complete=0;
    if (!spacer[0] || V(C0_a)>=threshold) quiescent=0;
    if (rx_index[1]!=2 || rx_phase[1]!=0) all_complete=0;
    if (!spacer[1] || V(C1_a)>=threshold) quiescent=0;
    if (rx_index[2]!=22 || rx_phase[2]!=0) all_complete=0;
    if (!spacer[2] || V(C2_a)>=threshold) quiescent=0;
    if (rx_index[3]!=22 || rx_phase[3]!=0) all_complete=0;
    if (!spacer[3] || V(C3_a)>=threshold) quiescent=0;
    if (active && !failure && all_complete && quiescent) begin
      finished=1; active=0; $display("SIM_ROUND t=%e inputs=26 outputs=48",$abstime);
    end
    if (finished && !quiescent && !failure) begin failure=1; $display("SIM_ERROR t=%e reason=nonquiescent_completion",$abstime); end
    if (finished && !failure && idle_start < 0) idle_start=$abstime+IDLE_SETTLE;
    if (finished && !failure && !idle_started && $abstime>=idle_start) begin
      idle_started=1;
      $display("SIM_IDLE_BEGIN t=%e reset=%e",$abstime,V(reset));
    end
    if (idle_started && !failure && !idle_completed && $abstime>=idle_start+IDLE_WINDOW) begin
      idle_completed=1;
      $display("SIM_IDLE_END t=%e reset=%e",$abstime,V(reset));
    end
    if (failure && (stop_after<0 || stop_after>$abstime+TD+2*EDGE)) stop_after=$abstime+TD+2*EDGE;
    else if (finished && stop_after<0) stop_after=$abstime+IDLE_SETTLE+IDLE_WINDOW+IDLE_MARGIN;
    if (!reported && stop_after>0 && $abstime>=stop_after) begin
      reported=1;
      if (failure) $display("SIM_FAIL t=%e reason=see_SIM_ERROR",$abstime);
      else $display("SIM_PASS t=%e rounds=1 inputs=26 outputs=48",$abstime);
      $finish(0);
    end
  end
  @(timer(STOP_TIME-4*TD-4*EDGE)) begin
    if (!finished && !failure) begin
      failure=1; $display("SIM_ERROR t=%e reason=timeout",$abstime);
      $display("SIM_STATE channel=I sent=%d phase=%d ack=%e",tx_index[0],tx_phase[0],V(I_a));
      $display("SIM_STATE channel=C0 received=%d phase=%d ack=%e",rx_index[0],rx_phase[0],V(C0_a));
      $display("SIM_STATE channel=C1 received=%d phase=%d ack=%e",rx_index[1],rx_phase[1],V(C1_a));
      $display("SIM_STATE channel=C2 received=%d phase=%d ack=%e",rx_index[2],rx_phase[2],V(C2_a));
      $display("SIM_STATE channel=C3 received=%d phase=%d ack=%e",rx_index[3],rx_phase[3],V(C3_a));
    end
  end
  V(I_t_0) <+ transition(SUPPLY*tx_valid[0]*((tx_word[0] >> 0) & 1),TD,EDGE,EDGE);
  V(I_f_0) <+ transition(SUPPLY*tx_valid[0]*(1-((tx_word[0] >> 0) & 1)),TD,EDGE,EDGE);
  V(I_t_1) <+ transition(SUPPLY*tx_valid[0]*((tx_word[0] >> 1) & 1),TD,EDGE,EDGE);
