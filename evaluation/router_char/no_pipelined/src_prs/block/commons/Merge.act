import "commons/Channels.act";

/* Bubble-reshuffled Merge: N=4 implements the supplied 4-bit merge PRS exactly.
 * _i_0a/_i_1a map to n_I0_a/n_I1_a; _o_{t,f}k to n_O_{t,f}[k].
 * Preserve the existing commons interface. WAIT_SPACER is retained only for
 * compatibility: acknowledgment release follows ~O.a in the supplied PRS.
 */
export template<pint N = 4; pbool WAIT_SPACER = true>
defproc Merge(ActiveDualRail?<N> I0; ActiveDualRail?<N> I1; ActiveDualRail!<N> O)
{
    bool n_I0_a, n_I1_a;
    bool n_O_t[N], n_O_f[N];

    prs {
        (O.a & (I0.t[N-1] | I0.f[N-1])) -> n_I0_a-
        ~O.a -> n_I0_a+
        (O.a & (I1.t[N-1] | I1.f[N-1])) -> n_I1_a-
        ~O.a -> n_I1_a+

        (k:N:
            (I0.t[k] | I1.t[k]) -> n_O_t[k]-
            (~I0.t[k] & ~I1.t[k]) -> n_O_t[k]+
            (I0.f[k] | I1.f[k]) -> n_O_f[k]-
            (~I0.f[k] & ~I1.f[k]) -> n_O_f[k]+
        )

        ~n_I0_a => I0.a+
        ~n_I1_a => I1.a+
        (k:N:
            ~n_O_t[k] => O.t[k]+
            ~n_O_f[k] => O.f[k]+
        )
    }
}
