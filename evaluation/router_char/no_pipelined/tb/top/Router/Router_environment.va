// Supply-current sampling continues after the functional round, with reset low.
parameter real IDLE_SETTLE=20n from (0:inf);
parameter real IDLE_WINDOW=20n from (0:inf);
parameter real IDLE_MARGIN=1n from (0:inf);
integer idle_started, idle_completed;
real idle_start;
analog begin
  @(initial_step) begin
    idle_start=-1; idle_started=0; idle_completed=0;
    active=0; finished=0; failure=0; reported=0;
    threshold=0.5*SUPPLY; stop_after=-1; release_time=-1;
    for (j=0;j<5;j=j+1) begin tx_index[j]=0; tx_phase[j]=0; tx_valid[j]=0; tx_word[j]=0; end
    for (j=0;j<5;j=j+1) begin rx_index[j]=0; rx_phase[j]=0; ack[j]=0; held[j]=0; end
    for (j=0;j<5;j=j+1) length[j]=0;
    for (j=0;j<80;j=j+1) packet[j]=0;
    for (j=0;j<100;j=j+1) hits[j]=0;
    for (j=0;j<56;j=j+1) issued[j]=0;
    if (SUPPLY<=0) begin failure=1; $display("SIM_ERROR reason=invalid_supply"); end
  end
  @(timer(CHECK_START,TICK)) begin
    input_spacer[0]=1;
    if (V(C0i_t_0)>=threshold || V(C0i_f_0)>=threshold) input_spacer[0]=0;
    if (V(C0i_t_1)>=threshold || V(C0i_f_1)>=threshold) input_spacer[0]=0;
    if (V(C0i_t_2)>=threshold || V(C0i_f_2)>=threshold) input_spacer[0]=0;
    if (V(C0i_t_3)>=threshold || V(C0i_f_3)>=threshold) input_spacer[0]=0;
    if (V(C0i_t_4)>=threshold || V(C0i_f_4)>=threshold) input_spacer[0]=0;
