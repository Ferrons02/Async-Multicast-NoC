electrical reset, I_t_0, I_t_1, I_t_2, I_t_3, I_f_0, I_f_1, I_f_2, I_f_3, I_a, O_t_0, O_t_1, O_t_2, O_t_3, O_t_4, O_t_5, O_t_6, O_t_7, O_t_8, O_t_9, O_t_10, O_t_11, O_t_12, O_t_13, O_t_14, O_t_15, O_t_16, O_t_17, O_t_18, O_t_19, O_t_20, O_t_21, O_t_22, O_t_23, O_t_24, O_t_25, O_t_26, O_t_27, O_t_28, O_t_29, O_t_30, O_t_31, O_f_0, O_f_1, O_f_2, O_f_3, O_f_4, O_f_5, O_f_6, O_f_7, O_f_8, O_f_9, O_f_10, O_f_11, O_f_12, O_f_13, O_f_14, O_f_15, O_f_16, O_f_17, O_f_18, O_f_19, O_f_20, O_f_21, O_f_22, O_f_23, O_f_24, O_f_25, O_f_26, O_f_27, O_f_28, O_f_29, O_f_30, O_f_31, O_a, done, failed;
parameter real SUPPLY=0.0;
parameter real TICK=10p from (0:inf);
parameter real TD=100p from (0:inf);
parameter real EDGE=10p from (0:inf);
parameter real STOP_TIME=2u from (0:inf);
integer active, finished, failure, reported;
integer tx_index, tx_phase, tx_valid, tx_word;
integer rx_index, rx_phase, ack, valid_word, spacer, illegal;
integer word_hi, word_lo, expected_hi, expected_lo, input_spacer;
real threshold, stop_after;
// Supply-current sampling continues after the functional round, with reset low.
parameter real IDLE_SETTLE=20n from (0:inf);
parameter real IDLE_WINDOW=20n from (0:inf);
parameter real IDLE_MARGIN=1n from (0:inf);
integer idle_started, idle_completed;
real idle_start;
analog begin
  @(initial_step) begin
    idle_start=-1; idle_started=0; idle_completed=0;
    active=0; finished=0; failure=0; reported=0;
    tx_index=0; tx_phase=0; tx_valid=0; tx_word=0;
    rx_index=0; rx_phase=0; ack=0; expected_hi=0; expected_lo=0;
    threshold=0.5*SUPPLY; stop_after=-1;
    if (SUPPLY<=0) begin failure=1; $display("SIM_ERROR reason=invalid_supply"); end
  end
  @(timer(TICK,TICK)) begin
    valid_word=1; spacer=1; illegal=0; word_hi=0; word_lo=0; input_spacer=1;
    if (V(I_t_0)>=threshold || V(I_f_0)>=threshold) input_spacer=0;
    if (V(I_t_1)>=threshold || V(I_f_1)>=threshold) input_spacer=0;
    if (V(I_t_2)>=threshold || V(I_f_2)>=threshold) input_spacer=0;
    if (V(I_t_3)>=threshold || V(I_f_3)>=threshold) input_spacer=0;
    if (V(O_t_0)<threshold && V(O_f_0)<threshold) valid_word=0;
    if (V(O_t_0)>=threshold || V(O_f_0)>=threshold) spacer=0;
    if (V(O_t_0)>=threshold && V(O_f_0)>=threshold) illegal=1;
    if (V(O_t_0)>=threshold) word_lo=word_lo | (1 << 0);
    if (V(O_t_1)<threshold && V(O_f_1)<threshold) valid_word=0;
    if (V(O_t_1)>=threshold || V(O_f_1)>=threshold) spacer=0;
    if (V(O_t_1)>=threshold && V(O_f_1)>=threshold) illegal=1;
    if (V(O_t_1)>=threshold) word_lo=word_lo | (1 << 1);
    if (V(O_t_2)<threshold && V(O_f_2)<threshold) valid_word=0;
    if (V(O_t_2)>=threshold || V(O_f_2)>=threshold) spacer=0;
    if (V(O_t_2)>=threshold && V(O_f_2)>=threshold) illegal=1;
    if (V(O_t_2)>=threshold) word_lo=word_lo | (1 << 2);
    if (V(O_t_3)<threshold && V(O_f_3)<threshold) valid_word=0;
    if (V(O_t_3)>=threshold || V(O_f_3)>=threshold) spacer=0;
    if (V(O_t_3)>=threshold && V(O_f_3)>=threshold) illegal=1;
    if (V(O_t_3)>=threshold) word_lo=word_lo | (1 << 3);
    if (V(O_t_4)<threshold && V(O_f_4)<threshold) valid_word=0;
    if (V(O_t_4)>=threshold || V(O_f_4)>=threshold) spacer=0;
    if (V(O_t_4)>=threshold && V(O_f_4)>=threshold) illegal=1;
    if (V(O_t_4)>=threshold) word_lo=word_lo | (1 << 4);
    if (V(O_t_5)<threshold && V(O_f_5)<threshold) valid_word=0;
    if (V(O_t_5)>=threshold || V(O_f_5)>=threshold) spacer=0;
    if (V(O_t_5)>=threshold && V(O_f_5)>=threshold) illegal=1;
    if (V(O_t_5)>=threshold) word_lo=word_lo | (1 << 5);
    if (V(O_t_6)<threshold && V(O_f_6)<threshold) valid_word=0;
    if (V(O_t_6)>=threshold || V(O_f_6)>=threshold) spacer=0;
    if (V(O_t_6)>=threshold && V(O_f_6)>=threshold) illegal=1;
    if (V(O_t_6)>=threshold) word_lo=word_lo | (1 << 6);
    if (V(O_t_7)<threshold && V(O_f_7)<threshold) valid_word=0;
    if (V(O_t_7)>=threshold || V(O_f_7)>=threshold) spacer=0;
