parameter real SUPPLY=0.0;
parameter real TICK=10p from (0:inf);
parameter real TD=100p from (0:inf);
parameter real EDGE=10p from (0:inf);
parameter real STOP_TIME=2u from (0:inf);
integer active, finished, failure, reported;
integer tx_index, tx_phase, tx_valid, tx_word, input_spacer;
integer stage, setup_stage, stage_complete, all_complete, quiescent;
real threshold, stop_after;
integer ci0, cp0, cv0, cw0, csp0, cvalid0;
integer ci1, cp1, cv1, cw1, csp1, cvalid1;
integer ci2, cp2, cv2, cw2, csp2, cvalid2;
integer ci3, cp3, cv3, cw3, csp3, cvalid3;
integer ri0, rp0, ack0, valid0, spacer0, illegal0, word0, expected0, remaining0, held0, held_word0;
integer ri1, rp1, ack1, valid1, spacer1, illegal1, word1, expected1, remaining1, held1, held_word1;
integer ri2, rp2, ack2, valid2, spacer2, illegal2, word2, expected2, remaining2, held2, held_word2;
integer ri3, rp3, ack3, valid3, spacer3, illegal3, word3, expected3, remaining3, held3, held_word3;
integer ri4, rp4, ack4, valid4, spacer4, illegal4, word4, expected4, remaining4, held4, held_word4;
integer ri5, rp5, ack5, valid5, spacer5, illegal5, word5, expected5, remaining5, held5, held_word5;
