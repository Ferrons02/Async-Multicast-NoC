    if (V(Cnt3_t_7)>=threshold || V(Cnt3_f_7)>=threshold) csp3=0;
    if (V(Cnt3_t_7)<threshold && V(Cnt3_f_7)<threshold) cvalid3=0;
    valid0=1; spacer0=1; illegal0=0; word0=0;
    if (V(OC0_t_0)<threshold && V(OC0_f_0)<threshold) valid0=0;
    if (V(OC0_t_0)>=threshold || V(OC0_f_0)>=threshold) spacer0=0;
    if (V(OC0_t_0)>=threshold && V(OC0_f_0)>=threshold) illegal0=1;
    if (V(OC0_t_0)>=threshold) word0=word0 | (1 << 0);
    if (V(OC0_t_1)<threshold && V(OC0_f_1)<threshold) valid0=0;
    if (V(OC0_t_1)>=threshold || V(OC0_f_1)>=threshold) spacer0=0;
    if (V(OC0_t_1)>=threshold && V(OC0_f_1)>=threshold) illegal0=1;
    if (V(OC0_t_1)>=threshold) word0=word0 | (1 << 1);
    if (V(OC0_t_2)<threshold && V(OC0_f_2)<threshold) valid0=0;
