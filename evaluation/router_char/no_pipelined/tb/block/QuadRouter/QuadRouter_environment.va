    if (V(Cnt2_t_4)<threshold && V(Cnt2_f_4)<threshold) cvalid2=0;
    if (V(Cnt2_t_5)>=threshold || V(Cnt2_f_5)>=threshold) csp2=0;
    if (V(Cnt2_t_5)<threshold && V(Cnt2_f_5)<threshold) cvalid2=0;
    if (V(Cnt2_t_6)>=threshold || V(Cnt2_f_6)>=threshold) csp2=0;
    if (V(Cnt2_t_6)<threshold && V(Cnt2_f_6)<threshold) cvalid2=0;
    if (V(Cnt2_t_7)>=threshold || V(Cnt2_f_7)>=threshold) csp2=0;
    if (V(Cnt2_t_7)<threshold && V(Cnt2_f_7)<threshold) cvalid2=0;
    csp3=1; cvalid3=1;
    if (V(Cnt3_t_0)>=threshold || V(Cnt3_f_0)>=threshold) csp3=0;
    if (V(Cnt3_t_0)<threshold && V(Cnt3_f_0)<threshold) cvalid3=0;
    if (V(Cnt3_t_1)>=threshold || V(Cnt3_f_1)>=threshold) csp3=0;
    if (V(Cnt3_t_1)<threshold && V(Cnt3_f_1)<threshold) cvalid3=0;
    if (V(Cnt3_t_2)>=threshold || V(Cnt3_f_2)>=threshold) csp3=0;
    if (V(Cnt3_t_2)<threshold && V(Cnt3_f_2)<threshold) cvalid3=0;
    if (V(Cnt3_t_3)>=threshold || V(Cnt3_f_3)>=threshold) csp3=0;
    if (V(Cnt3_t_3)<threshold && V(Cnt3_f_3)<threshold) cvalid3=0;
    if (V(Cnt3_t_4)>=threshold || V(Cnt3_f_4)>=threshold) csp3=0;
    if (V(Cnt3_t_4)<threshold && V(Cnt3_f_4)<threshold) cvalid3=0;
    if (V(Cnt3_t_5)>=threshold || V(Cnt3_f_5)>=threshold) csp3=0;
    if (V(Cnt3_t_5)<threshold && V(Cnt3_f_5)<threshold) cvalid3=0;
    if (V(Cnt3_t_6)>=threshold || V(Cnt3_f_6)>=threshold) csp3=0;
