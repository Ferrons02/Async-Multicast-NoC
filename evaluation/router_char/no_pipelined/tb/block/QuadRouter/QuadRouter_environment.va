integer ri7, rp7, ack7, valid7, spacer7, illegal7, word7, expected7, remaining7, held7, held_word7;
integer ri8, rp8, ack8, valid8, spacer8, illegal8, word8, expected8, remaining8, held8, held_word8;
// Supply-current sampling continues after the functional round, with reset low.
parameter real IDLE_SETTLE=20n from (0:inf);
parameter real IDLE_WINDOW=20n from (0:inf);
parameter real IDLE_MARGIN=1n from (0:inf);
integer idle_started, idle_completed;
real idle_start;
analog begin
  @(initial_step) begin
    idle_start=-1; idle_started=0; idle_completed=0;
    active=0; finished=0; failure=0; reported=0;
    tx_index=0; tx_phase=0; tx_valid=0; tx_word=0;
    stage=0; setup_stage=1; threshold=0.5*SUPPLY; stop_after=-1;
    ci0=0; cp0=0; cv0=0; cw0=0;
    ci1=0; cp1=0; cv1=0; cw1=0;
    ci2=0; cp2=0; cv2=0; cw2=0;
    ci3=0; cp3=0; cv3=0; cw3=0;
    ri0=0; rp0=0; ack0=0; expected0=0; remaining0=0; held0=0; held_word0=0;
    ri1=0; rp1=0; ack1=0; expected1=0; remaining1=0; held1=0; held_word1=0;
    ri2=0; rp2=0; ack2=0; expected2=0; remaining2=0; held2=0; held_word2=0;
    ri3=0; rp3=0; ack3=0; expected3=0; remaining3=0; held3=0; held_word3=0;
    ri4=0; rp4=0; ack4=0; expected4=0; remaining4=0; held4=0; held_word4=0;
    ri5=0; rp5=0; ack5=0; expected5=0; remaining5=0; held5=0; held_word5=0;
    ri6=0; rp6=0; ack6=0; expected6=0; remaining6=0; held6=0; held_word6=0;
    ri7=0; rp7=0; ack7=0; expected7=0; remaining7=0; held7=0; held_word7=0;
    ri8=0; rp8=0; ack8=0; expected8=0; remaining8=0; held8=0; held_word8=0;
    if (SUPPLY<=0) begin failure=1; $display("SIM_ERROR reason=invalid_supply"); end
  end
  @(timer(TICK,TICK)) begin
    input_spacer=1;
    if (V(I_t_0)>=threshold || V(I_f_0)>=threshold) input_spacer=0;
    if (V(I_t_1)>=threshold || V(I_f_1)>=threshold) input_spacer=0;
    if (V(I_t_2)>=threshold || V(I_f_2)>=threshold) input_spacer=0;
    if (V(I_t_3)>=threshold || V(I_f_3)>=threshold) input_spacer=0;
    csp0=1; cvalid0=1;
    if (V(Cnt0_t_0)>=threshold || V(Cnt0_f_0)>=threshold) csp0=0;
    if (V(Cnt0_t_0)<threshold && V(Cnt0_f_0)<threshold) cvalid0=0;
    if (V(Cnt0_t_1)>=threshold || V(Cnt0_f_1)>=threshold) csp0=0;
    if (V(Cnt0_t_1)<threshold && V(Cnt0_f_1)<threshold) cvalid0=0;
    if (V(Cnt0_t_2)>=threshold || V(Cnt0_f_2)>=threshold) csp0=0;
    if (V(Cnt0_t_2)<threshold && V(Cnt0_f_2)<threshold) cvalid0=0;
    if (V(Cnt0_t_3)>=threshold || V(Cnt0_f_3)>=threshold) csp0=0;
    if (V(Cnt0_t_3)<threshold && V(Cnt0_f_3)<threshold) cvalid0=0;
    if (V(Cnt0_t_4)>=threshold || V(Cnt0_f_4)>=threshold) csp0=0;
    if (V(Cnt0_t_4)<threshold && V(Cnt0_f_4)<threshold) cvalid0=0;
    if (V(Cnt0_t_5)>=threshold || V(Cnt0_f_5)>=threshold) csp0=0;
    if (V(Cnt0_t_5)<threshold && V(Cnt0_f_5)<threshold) cvalid0=0;
    if (V(Cnt0_t_6)>=threshold || V(Cnt0_f_6)>=threshold) csp0=0;
    if (V(Cnt0_t_6)<threshold && V(Cnt0_f_6)<threshold) cvalid0=0;
    if (V(Cnt0_t_7)>=threshold || V(Cnt0_f_7)>=threshold) csp0=0;
    if (V(Cnt0_t_7)<threshold && V(Cnt0_f_7)<threshold) cvalid0=0;
    csp1=1; cvalid1=1;
    if (V(Cnt1_t_0)>=threshold || V(Cnt1_f_0)>=threshold) csp1=0;
    if (V(Cnt1_t_0)<threshold && V(Cnt1_f_0)<threshold) cvalid1=0;
    if (V(Cnt1_t_1)>=threshold || V(Cnt1_f_1)>=threshold) csp1=0;
    if (V(Cnt1_t_1)<threshold && V(Cnt1_f_1)<threshold) cvalid1=0;
    if (V(Cnt1_t_2)>=threshold || V(Cnt1_f_2)>=threshold) csp1=0;
    if (V(Cnt1_t_2)<threshold && V(Cnt1_f_2)<threshold) cvalid1=0;
    if (V(Cnt1_t_3)>=threshold || V(Cnt1_f_3)>=threshold) csp1=0;
    if (V(Cnt1_t_3)<threshold && V(Cnt1_f_3)<threshold) cvalid1=0;
    if (V(Cnt1_t_4)>=threshold || V(Cnt1_f_4)>=threshold) csp1=0;
    if (V(Cnt1_t_4)<threshold && V(Cnt1_f_4)<threshold) cvalid1=0;
    if (V(Cnt1_t_5)>=threshold || V(Cnt1_f_5)>=threshold) csp1=0;
    if (V(Cnt1_t_5)<threshold && V(Cnt1_f_5)<threshold) cvalid1=0;
    if (V(Cnt1_t_6)>=threshold || V(Cnt1_f_6)>=threshold) csp1=0;
    if (V(Cnt1_t_6)<threshold && V(Cnt1_f_6)<threshold) cvalid1=0;
    if (V(Cnt1_t_7)>=threshold || V(Cnt1_f_7)>=threshold) csp1=0;
    if (V(Cnt1_t_7)<threshold && V(Cnt1_f_7)<threshold) cvalid1=0;
    csp2=1; cvalid2=1;
    if (V(Cnt2_t_0)>=threshold || V(Cnt2_f_0)>=threshold) csp2=0;
    if (V(Cnt2_t_0)<threshold && V(Cnt2_f_0)<threshold) cvalid2=0;
    if (V(Cnt2_t_1)>=threshold || V(Cnt2_f_1)>=threshold) csp2=0;
    if (V(Cnt2_t_1)<threshold && V(Cnt2_f_1)<threshold) cvalid2=0;
    if (V(Cnt2_t_2)>=threshold || V(Cnt2_f_2)>=threshold) csp2=0;
    if (V(Cnt2_t_2)<threshold && V(Cnt2_f_2)<threshold) cvalid2=0;
