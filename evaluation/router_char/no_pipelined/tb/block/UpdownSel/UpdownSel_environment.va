        end else if (rx_phase1 == 1) begin
          if (valid1 && (word1_hi != expected1_hi || word1_lo != expected1_lo)) begin
            failure=1; $display("SIM_ERROR t=%e reason=word_changed_without_spacer channel=O1", $abstime);
          end else if (!valid1 && V(O1_a) < threshold) begin
            failure=1; $display("SIM_ERROR t=%e reason=data_withdrawn_before_ack channel=O1", $abstime);
          end else if (spacer1 && V(O1_a) >= threshold) begin
            ack1=0; rx_phase1=2;
            $display("SIM_SPACER t=%e channel=O1 index=%d", $abstime, rx_index1);
          end
        end else if (rx_phase1 == 2) begin
          if (!spacer1) begin
            failure=1; $display("SIM_ERROR t=%e reason=data_before_ack_low channel=O1", $abstime);
          end else if (V(O1_a) < threshold) begin
            $display("SIM_ACK_LOW t=%e channel=O1 index=%d", $abstime, rx_index1);
            rx_index1=rx_index1+1; rx_phase1=0;
          end
        end
      end
      if (active && !failure) begin
        if (tx_phase == 1 && V(I_a) >= threshold) begin
          if ((tx_index < 3 && V(O0_a) < threshold) || (tx_index >= 3 && V(O1_a) < threshold)) begin
            failure=1; $display("SIM_ERROR t=%e reason=early_input_ack index=%d", $abstime, tx_index);
          end else begin
            tx_valid=0; tx_phase=2;
            $display("SIM_IACK_HIGH t=%e index=%d", $abstime, tx_index);
          end
        end else if (tx_phase == 2 && V(I_a) < threshold && input_spacer) begin
          $display("SIM_IACK_LOW t=%e index=%d", $abstime, tx_index);
          tx_index=tx_index+1; tx_phase=0;
        end
        if (!failure && tx_index == 6 && rx_index0 == 3 && rx_index1 == 3 &&
            tx_phase == 0 && rx_phase0 == 0 && rx_phase1 == 0 &&
            input_spacer && spacer0 && spacer1 && V(I_a) < threshold &&
            V(O0_a) < threshold && V(O1_a) < threshold) begin
          finished=1; active=0;
          $display("SIM_ROUND t=%e inputs=6 O0=3 O1=3", $abstime);
        end
        if (!failure && !finished && tx_phase == 0 && tx_index < 6 && V(I_a) < threshold && input_spacer) begin
          case (tx_index)
            0: begin tx_hi=65535; tx_lo=65534; end
            1: begin tx_hi=4095; tx_lo=65534; end
            2: begin tx_hi=65535; tx_lo=65535; end
            3: begin tx_hi=32767; tx_lo=65534; end
            4: begin tx_hi=8191; tx_lo=65534; end
            5: begin tx_hi=65535; tx_lo=65535; end
          endcase
          tx_valid=1; tx_phase=1;
          $display("SIM_TX t=%e index=%d word=%04h%04h", $abstime, tx_index, tx_hi, tx_lo);
        end
      end
      if (finished && (!input_spacer || !spacer0 || !spacer1 || V(I_a) >= threshold)) begin
        failure=1; $display("SIM_ERROR t=%e reason=nonquiescent_completion", $abstime);
      end
    end
    if (finished && !failure && idle_start < 0) idle_start=$abstime+IDLE_SETTLE;
    if (finished && !failure && !idle_started && $abstime>=idle_start) begin
      idle_started=1;
      $display("SIM_IDLE_BEGIN t=%e reset=%e",$abstime,V(reset));
    end
    if (idle_started && !failure && !idle_completed && $abstime>=idle_start+IDLE_WINDOW) begin
      idle_completed=1;
      $display("SIM_IDLE_END t=%e reset=%e",$abstime,V(reset));
    end
    if (failure && (stop_after<0 || stop_after>$abstime+TD+2*EDGE)) stop_after=$abstime+TD+2*EDGE;
    else if (finished && stop_after<0) stop_after=$abstime+IDLE_SETTLE+IDLE_WINDOW+IDLE_MARGIN;
    if (!reported && stop_after > 0 && $abstime >= stop_after) begin
      reported=1;
      if (failure) $display("SIM_FAIL t=%e reason=see_SIM_ERROR", $abstime);
      else $display("SIM_PASS t=%e rounds=1 inputs=6 O0=3 O1=3", $abstime);
      $finish(0);
    end
  end
  @(timer(STOP_TIME-4*TD-4*EDGE)) begin
    if (!finished && !failure) begin
      failure=1;
      $display("SIM_ERROR t=%e reason=timeout tx_index=%d tx_phase=%d rx0=%d rx1=%d I.a=%e", $abstime, tx_index, tx_phase, rx_index0, rx_index1, V(I_a));
    end
  end
  V(I_t_0) <+ transition(SUPPLY*tx_valid*((tx_lo >> 0) & 1), TD, EDGE, EDGE);
  V(I_f_0) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 0) & 1)), TD, EDGE, EDGE);
  V(I_t_1) <+ transition(SUPPLY*tx_valid*((tx_lo >> 1) & 1), TD, EDGE, EDGE);
  V(I_f_1) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 1) & 1)), TD, EDGE, EDGE);
  V(I_t_2) <+ transition(SUPPLY*tx_valid*((tx_lo >> 2) & 1), TD, EDGE, EDGE);
  V(I_f_2) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 2) & 1)), TD, EDGE, EDGE);
  V(I_t_3) <+ transition(SUPPLY*tx_valid*((tx_lo >> 3) & 1), TD, EDGE, EDGE);
  V(I_f_3) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 3) & 1)), TD, EDGE, EDGE);
  V(I_t_4) <+ transition(SUPPLY*tx_valid*((tx_lo >> 4) & 1), TD, EDGE, EDGE);
  V(I_f_4) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 4) & 1)), TD, EDGE, EDGE);
  V(I_t_5) <+ transition(SUPPLY*tx_valid*((tx_lo >> 5) & 1), TD, EDGE, EDGE);
  V(I_f_5) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 5) & 1)), TD, EDGE, EDGE);
  V(I_t_6) <+ transition(SUPPLY*tx_valid*((tx_lo >> 6) & 1), TD, EDGE, EDGE);
  V(I_f_6) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 6) & 1)), TD, EDGE, EDGE);
  V(I_t_7) <+ transition(SUPPLY*tx_valid*((tx_lo >> 7) & 1), TD, EDGE, EDGE);
  V(I_f_7) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 7) & 1)), TD, EDGE, EDGE);
  V(I_t_8) <+ transition(SUPPLY*tx_valid*((tx_lo >> 8) & 1), TD, EDGE, EDGE);
  V(I_f_8) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 8) & 1)), TD, EDGE, EDGE);
  V(I_t_9) <+ transition(SUPPLY*tx_valid*((tx_lo >> 9) & 1), TD, EDGE, EDGE);
  V(I_f_9) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 9) & 1)), TD, EDGE, EDGE);
  V(I_t_10) <+ transition(SUPPLY*tx_valid*((tx_lo >> 10) & 1), TD, EDGE, EDGE);
  V(I_f_10) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 10) & 1)), TD, EDGE, EDGE);
  V(I_t_11) <+ transition(SUPPLY*tx_valid*((tx_lo >> 11) & 1), TD, EDGE, EDGE);
  V(I_f_11) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 11) & 1)), TD, EDGE, EDGE);
  V(I_t_12) <+ transition(SUPPLY*tx_valid*((tx_lo >> 12) & 1), TD, EDGE, EDGE);
  V(I_f_12) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 12) & 1)), TD, EDGE, EDGE);
  V(I_t_13) <+ transition(SUPPLY*tx_valid*((tx_lo >> 13) & 1), TD, EDGE, EDGE);
  V(I_f_13) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 13) & 1)), TD, EDGE, EDGE);
  V(I_t_14) <+ transition(SUPPLY*tx_valid*((tx_lo >> 14) & 1), TD, EDGE, EDGE);
  V(I_f_14) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 14) & 1)), TD, EDGE, EDGE);
  V(I_t_15) <+ transition(SUPPLY*tx_valid*((tx_lo >> 15) & 1), TD, EDGE, EDGE);
  V(I_f_15) <+ transition(SUPPLY*tx_valid*(1-((tx_lo >> 15) & 1)), TD, EDGE, EDGE);
  V(I_t_16) <+ transition(SUPPLY*tx_valid*((tx_hi >> 0) & 1), TD, EDGE, EDGE);
  V(I_f_16) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 0) & 1)), TD, EDGE, EDGE);
  V(I_t_17) <+ transition(SUPPLY*tx_valid*((tx_hi >> 1) & 1), TD, EDGE, EDGE);
  V(I_f_17) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 1) & 1)), TD, EDGE, EDGE);
  V(I_t_18) <+ transition(SUPPLY*tx_valid*((tx_hi >> 2) & 1), TD, EDGE, EDGE);
  V(I_f_18) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 2) & 1)), TD, EDGE, EDGE);
  V(I_t_19) <+ transition(SUPPLY*tx_valid*((tx_hi >> 3) & 1), TD, EDGE, EDGE);
  V(I_f_19) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 3) & 1)), TD, EDGE, EDGE);
  V(I_t_20) <+ transition(SUPPLY*tx_valid*((tx_hi >> 4) & 1), TD, EDGE, EDGE);
  V(I_f_20) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 4) & 1)), TD, EDGE, EDGE);
  V(I_t_21) <+ transition(SUPPLY*tx_valid*((tx_hi >> 5) & 1), TD, EDGE, EDGE);
  V(I_f_21) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 5) & 1)), TD, EDGE, EDGE);
  V(I_t_22) <+ transition(SUPPLY*tx_valid*((tx_hi >> 6) & 1), TD, EDGE, EDGE);
  V(I_f_22) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 6) & 1)), TD, EDGE, EDGE);
  V(I_t_23) <+ transition(SUPPLY*tx_valid*((tx_hi >> 7) & 1), TD, EDGE, EDGE);
  V(I_f_23) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 7) & 1)), TD, EDGE, EDGE);
  V(I_t_24) <+ transition(SUPPLY*tx_valid*((tx_hi >> 8) & 1), TD, EDGE, EDGE);
  V(I_f_24) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 8) & 1)), TD, EDGE, EDGE);
  V(I_t_25) <+ transition(SUPPLY*tx_valid*((tx_hi >> 9) & 1), TD, EDGE, EDGE);
  V(I_f_25) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 9) & 1)), TD, EDGE, EDGE);
  V(I_t_26) <+ transition(SUPPLY*tx_valid*((tx_hi >> 10) & 1), TD, EDGE, EDGE);
  V(I_f_26) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 10) & 1)), TD, EDGE, EDGE);
  V(I_t_27) <+ transition(SUPPLY*tx_valid*((tx_hi >> 11) & 1), TD, EDGE, EDGE);
  V(I_f_27) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 11) & 1)), TD, EDGE, EDGE);
  V(I_t_28) <+ transition(SUPPLY*tx_valid*((tx_hi >> 12) & 1), TD, EDGE, EDGE);
  V(I_f_28) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 12) & 1)), TD, EDGE, EDGE);
  V(I_t_29) <+ transition(SUPPLY*tx_valid*((tx_hi >> 13) & 1), TD, EDGE, EDGE);
  V(I_f_29) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 13) & 1)), TD, EDGE, EDGE);
  V(I_t_30) <+ transition(SUPPLY*tx_valid*((tx_hi >> 14) & 1), TD, EDGE, EDGE);
  V(I_f_30) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 14) & 1)), TD, EDGE, EDGE);
  V(I_t_31) <+ transition(SUPPLY*tx_valid*((tx_hi >> 15) & 1), TD, EDGE, EDGE);
  V(I_f_31) <+ transition(SUPPLY*tx_valid*(1-((tx_hi >> 15) & 1)), TD, EDGE, EDGE);
  V(O0_a) <+ transition(SUPPLY*ack0, TD, EDGE, EDGE);
  V(O1_a) <+ transition(SUPPLY*ack1, TD, EDGE, EDGE);
  V(done) <+ transition(SUPPLY*(finished && !failure), TD, EDGE, EDGE);
  V(failed) <+ transition(SUPPLY*failure, TD, EDGE, EDGE);
end
endmodule
