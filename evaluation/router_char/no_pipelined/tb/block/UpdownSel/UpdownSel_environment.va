parameter real SUPPLY = 0.0;
parameter real TICK = 10p from (0:inf);
parameter real TD = 100p from (0:inf);
parameter real EDGE = 10p from (0:inf);
parameter real STOP_TIME = 2u from (0:inf);
// Exactly one round: six input words, three output words per port.
// Use two unsigned 16-bit halves: pVA R-2020 misencoded 32-bit hex literals.
integer active, finished, failure, tx_index, tx_phase, tx_valid, tx_hi, tx_lo;
integer rx_index0, rx_index1, rx_phase0, rx_phase1, ack0, ack1;
integer valid0, valid1, spacer0, spacer1, illegal0, illegal1;
