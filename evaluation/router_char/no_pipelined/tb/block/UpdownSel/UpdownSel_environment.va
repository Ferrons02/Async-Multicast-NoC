integer input_spacer, reported;
integer expected0_hi, expected0_lo, expected1_hi, expected1_lo;
real threshold, stop_after;
// Supply-current sampling continues after the functional round, with reset low.
parameter real IDLE_SETTLE=20n from (0:inf);
parameter real IDLE_WINDOW=20n from (0:inf);
parameter real IDLE_MARGIN=1n from (0:inf);
integer idle_started, idle_completed;
real idle_start;
analog begin
  @(initial_step) begin
    idle_start=-1; idle_started=0; idle_completed=0;
    active=0; finished=0; failure=0;
    tx_index=0; tx_phase=0; tx_valid=0; tx_hi=0; tx_lo=0; stop_after=-1;
    rx_index0=0; rx_index1=0; rx_phase0=0; rx_phase1=0; ack0=0; ack1=0;
    threshold=0.5*SUPPLY; reported=0;
    if (SUPPLY <= 0.0) begin failure=1; $display("SIM_ERROR reason=invalid_supply"); end
